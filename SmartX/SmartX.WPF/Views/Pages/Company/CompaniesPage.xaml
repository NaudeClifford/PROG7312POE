<Page x:Class="SmartX.WPF.Views.Pages.Company.CompaniesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#F5F7FA">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Companies"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#1F2937"/>

                <TextBlock Text="Manage SmartX companies"
                           Margin="0,5,0,0"
                           FontSize="14"
                           Foreground="#6B7280"/>

            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Margin="10,0,10,0"
                    Padding="20,10"/>

            <Button Grid.Column="2"
                    Content="Back"
                    Command="{Binding BackCommand}"
                    Padding="20,10"/>

        </Grid>

        <!-- ================================================= -->
        <!-- SUMMARY -->
        <!-- ================================================= -->

        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="0,0,0,25">

            <Border Margin="5"
                    Padding="15"
                    Background="White"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="Total Companies"
                               Foreground="#6B7280"/>

                    <TextBlock Text="{Binding TotalCompanies}"
                               FontSize="24"
                               FontWeight="Bold"/>
                </StackPanel>

            </Border>

            <Border Margin="5"
                    Padding="15"
                    Background="White"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="Active"
                               Foreground="#6B7280"/>

                    <TextBlock Text="{Binding ActiveCompanies}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#16A34A"/>
                </StackPanel>

            </Border>

            <Border Margin="5"
                    Padding="15"
                    Background="White"
                    CornerRadius="8">

                <StackPanel>
                    <TextBlock Text="Inactive"
                               Foreground="#6B7280"/>

                    <TextBlock Text="{Binding InactiveCompanies}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#DC2626"/>
                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- ================================================= -->
        <!-- COMPANIES -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="15">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="All Companies"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="5,0,0,15"/>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Companies}"
                          SelectedItem="{Binding SelectedCompany}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Company Name"
                                            Binding="{Binding Name}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description}"
                                            Width="2*"/>

                        <DataGridCheckBoxColumn Header="Active"
                                                Binding="{Binding IsActive}"
                                                Width="*"/>
                        
                        <DataGridTextColumn Header="Deletion Request"
                        Binding="{Binding DeletionRequest}"
                        Width="*"/>
                        
                        <DataGridTextColumn Header="Created"
                                            Binding="{Binding CreatedAt}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Updated"
                                            Binding="{Binding UpdatedAt}"
                                            Width="*"/>

                        
                    </DataGrid.Columns>

                </DataGrid>

                <!-- COMPANY ACTIONS -->

                <StackPanel
    Grid.Row="2"
    Orientation="Horizontal"
    Margin="5,10,5,0">

                    <TextBlock
        Text="{Binding ErrorMessage}"
        Foreground="#DC2626"
        FontSize="13"
        TextWrapping="Wrap"
        VerticalAlignment="Center"
        Margin="0,0,20,0"/>

                    <Button
        Content="Delete Company"
        Command="{Binding DeleteCompanyCommand}"
        Width="150"
        Height="38"
        Background="#DC2626"
        Foreground="White"
        BorderBrush="#B91C1C"
        FontWeight="SemiBold"
        HorizontalAlignment="Right"/>
                </StackPanel>


            </Grid>

        </Border>

    </Grid>

</Page>