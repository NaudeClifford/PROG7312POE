<Page x:Class="SmartX.WPF.Views.Pages.Gateway.GatewayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Gateway"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="60">

            <Grid.RowDefinitions>

                <!-- Header -->
                <RowDefinition Height="Auto"/>

                <!-- Gateway cards -->
                <RowDefinition Height="Auto"/>

                <!-- No gateway -->
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- HEADER -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="500"/>
                </Grid.ColumnDefinitions>


                <!-- TITLE -->

                <StackPanel>

                    <TextBlock Text="Gateway"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource TitleBrush}"/>

                    <TextBlock Text="{Binding CurrentGatewayName}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}"
                               Margin="0,5,0,0"/>

                    <TextBlock Text="Manage your SmartX gateway and connected services."
                               FontSize="14"
                               Foreground="{StaticResource TitleBrush}"
                               Margin="0,8,0,0"/>

                </StackPanel>


                <!-- GATEWAY SELECTOR -->

                <StackPanel Grid.Column="1">

                    <!-- CRUD BUTTONS -->

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="{Binding GatewayCrudVisibility}"
                                Margin="0,0,0,10">

                        <!-- ADD GATEWAY -->

                        <Button Content="+ Add Gateway"
                                Command="{Binding AddGatewayCommand}"
                                Width="150"
                                Height="40"
                                Padding="18,0"
                                Margin="1,0,8,0"
                                Style="{StaticResource PrimaryButtonStyle}"/>


                        <!-- EDIT -->

                        <Button Content="Edit"
                                Width="90"
                                Height="40"
                                Margin="0,0,8,0"
                                Command="{Binding EditGatewayCommand}"
                                Style="{StaticResource BaseButtonStyle}"/>


                        <!-- DELETE -->

                        <Button Content="Delete"
                                Width="90"
                                Height="40"
                                Command="{Binding DeleteGatewayCommand}"
                                Background="#C62828"
                                Foreground="White"/>

                    </StackPanel>


                    <!-- SELECT GATEWAY -->

                    <TextBlock Text="SELECT GATEWAY"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#707780"
                               Margin="0,0,0,6"/>

                    <ComboBox ItemsSource="{Binding Gateways}"
                              SelectedItem="{Binding SelectedGateway, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Height="42"
                              FontWeight="ExtraBold"
                              FontSize="20"
                              Margin="0,0,0,10"
                              Background="{StaticResource BackgroundBrush}"/>

                </StackPanel>

            </Grid>


            <!-- GATEWAY CARDS -->

            <Grid Grid.Row="1"
                  Visibility="{Binding GatewayFeaturesVisibility}"
                  Margin="0,30,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- SENSOR DATA & TELEMETRY -->

                <Border Grid.Column="0"
                        Background="#F3F4F6"
                        CornerRadius="16"
                        Padding="25"
                        Margin="0,0,10,0">

                    <StackPanel>

                        <TextBlock Text="Sensor Data &amp; Telemetry"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"/>

                        <TextBlock Text="View live sensor readings and telemetry coming through this gateway."
                                   FontSize="13"
                                   Foreground="#707780"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,20"/>

                        <Button Content="View Sensor Data"
                                Height="45"
                                Command="{Binding ViewSensorsCommand}"
                                Style="{StaticResource BaseButtonStyle}"/>

                    </StackPanel>

                </Border>


                <!-- COMMAND STREAM & HISTORY -->

                <Border Grid.Column="1"
                        Background="#F3F4F6"
                        CornerRadius="16"
                        Padding="25"
                        Margin="5,0">

                    <StackPanel>

                        <TextBlock Text="Command Stream &amp; History"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"/>

                        <TextBlock Text="View gateway commands, command history and gateway activity."
                                   FontSize="13"
                                   Foreground="#707780"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,20"/>

                        <Button Content="View Command History"
                                Height="45"
                                Command="{Binding ViewCommandHistoryCommand}"
                                Style="{StaticResource BaseButtonStyle}"
                                IsEnabled="False"/>

                    </StackPanel>

                </Border>


                <!-- NETWORK & MESH -->

                <Border Grid.Column="2"
                        Background="#F3F4F6"
                        CornerRadius="16"
                        Padding="25"
                        Margin="10,0,0,0">

                    <StackPanel>

                        <TextBlock Text="Network &amp; Mesh Routing"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"/>

                        <TextBlock Text="View gateway network status and configure mesh routing."
                                   FontSize="13"
                                   Foreground="#707780"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,20"/>

                        <Button Content="View Network"
                                Height="45"
                                Command="{Binding ViewNetworkCommand}"
                                Style="{StaticResource BaseButtonStyle}"
                                IsEnabled="False"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- NO GATEWAY -->

            <Border Grid.Row="2"
                    Visibility="{Binding NoGatewayVisibility}"
                    Background="White"
                    CornerRadius="16"
                    Padding="40"
                    Margin="0,30,0,0">

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="500">

                    <TextBlock Text="No Gateway Configured"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#20242A"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="This company does not currently have a SmartX gateway configured. Gateway-dependent features will become available after a gateway is added."
                               FontSize="14"
                               Foreground="#707780"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,12,0,25"/>

                    <Button Content="+ Add Gateway"
                            Command="{Binding AddGatewayCommand}"
                            Visibility="{Binding GatewayCrudVisibility}"
                            Width="180"
                            Height="45"
                            HorizontalAlignment="Center"
                            Style="{StaticResource BaseButtonStyle}"/>

                </StackPanel>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>