<Page x:Class="SmartX.WPF.Views.Pages.Gateway.GatewayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Gateway"
      Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="60">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>


                <!-- TITLE -->

                <StackPanel>

                    <TextBlock Text="Gateway"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#20242A"/>

                    <TextBlock Text="Manage your SmartX gateway and connected services."
                               FontSize="14"
                               Foreground="#707780"
                               Margin="0,8,0,0"/>

                </StackPanel>


                <!-- GATEWAY SELECTOR -->

                <StackPanel Grid.Column="1">

                    <!-- ADD GATEWAY -->

                    <Button Content="+ Add Gateway"
                            Command="{Binding AddGatewayCommand}"
                            Height="40"
                            HorizontalAlignment="Right"
                            Padding="18,0"
                            Margin="0,0,0,15"
                            Style="{StaticResource BaseButtonStyle}"/>


                    <TextBlock Text="SELECT GATEWAY"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#707780"
                               Margin="0,0,0,6"/>


                    <ComboBox ItemsSource="{Binding Gateways}"
                              SelectedItem="{Binding SelectedGateway, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Height="42"/>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- GATEWAY INFORMATION -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="14"
                    Padding="24"
                    Margin="0,30,0,25">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel>

                        <TextBlock Text="{Binding Gateway.Name}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"/>

                        <TextBlock Text="{Binding Gateway.Description}"
                                   FontSize="13"
                                   Foreground="#707780"
                                   Margin="0,5,0,0"/>

                        <TextBlock Text="{Binding Gateway.SerialNumber}"
                                   FontSize="13"
                                   Foreground="#707780"
                                   Margin="0,10,0,0"/>

                    </StackPanel>


                    <!-- STATUS -->

                    <Border Grid.Column="1"
                            Background="#E8F5E9"
                            CornerRadius="20"
                            Padding="15,8"
                            VerticalAlignment="Center">

                        <TextBlock Text="ONLINE"
                                   Foreground="#2E7D32"
                                   FontWeight="Bold"
                                   FontSize="12"/>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- GATEWAY CARDS -->
            <!-- ================================================= -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- ================================================= -->
                <!-- SENSOR DATA & TELEMETRY -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="16"
                        Padding="25"
                        Margin="0,0,10,0">

                    <StackPanel>

                        <TextBlock Text="Sensor Data &amp; Telemetry"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"/>

                        <TextBlock Text="View live sensor readings and telemetry coming through this gateway."
                                   FontSize="13"
                                   Foreground="#707780"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,20"/>

                        <Button Content="View Sensor Data"
                                Height="45"
                                Command="{Binding ViewSensorsCommand}"
                                Style="{StaticResource BaseButtonStyle}"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- COMMAND STREAM & HISTORY -->
                <!-- ================================================= -->

                <Border Grid.Column="1"
                        Background="#F3F4F6"
                        CornerRadius="16"
                        Padding="25"
                        Margin="5,0">

                    <StackPanel>

                        <TextBlock Text="Command Stream &amp; History"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"/>

                        <TextBlock Text="View gateway commands, command history and gateway activity."
                                   FontSize="13"
                                   Foreground="#707780"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,20"/>

                        <Button Content="View Command History"
                                Height="45"
                                Command="{Binding ViewCommandHistoryCommand}"
                                Style="{StaticResource BaseButtonStyle}"/>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- NETWORK & MESH -->
                <!-- ================================================= -->

                <Border Grid.Column="2"
                        Background="#F3F4F6"
                        CornerRadius="16"
                        Padding="25"
                        Margin="10,0,0,0">

                    <StackPanel>

                        <TextBlock Text="Network &amp; Mesh Routing"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A"/>

                        <TextBlock Text="View gateway network status and configure mesh routing."
                                   FontSize="13"
                                   Foreground="#707780"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,20"/>

                        <Button Content="View Network"
                                Height="45"
                                Command="{Binding ViewNetworkCommand}"
                                Style="{StaticResource BaseButtonStyle}"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

    </ScrollViewer>

</Page>