<Page x:Class="SmartX.WPF.Views.Pages.Gateway.GatewaySetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Gateway Setup"
      Background="{StaticResource BackgroundBrush}"
                      PreviewKeyDown="Page_PreviewKeyDown">


    <ScrollViewer
        VerticalScrollBarVisibility="Auto">

        <Grid Margin="60">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <StackPanel Grid.Row="0">

                <TextBlock
                    Text="Gateway Setup"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#20242A"/>

                <TextBlock
                    Text="Configure gateways for your SmartX company."
                    FontSize="14"
                    Foreground="#707780"
                    Margin="0,8,0,30"/>

            </StackPanel>


            <!-- SETUP FORM -->

            <Border
                Grid.Row="1"
                Background="White"
                CornerRadius="18"
                Padding="35">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- NAME -->

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,18">

                        <TextBlock
                            Text="Gateway name"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- SERIAL -->

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="12,0,0,18">

                        <TextBlock
                            Text="Serial number"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- IP -->

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,12,18">

                        <TextBlock
                            Text="IP address"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- DESCRIPTION -->

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,0,0,18">

                        <TextBlock
                            Text="Description"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- STATUS -->

                    <TextBlock
    Grid.Row="2"
    Grid.ColumnSpan="2"
    Text="{Binding ErrorMessage}"
    Foreground="#C62828"
    FontSize="13"
    TextWrapping="Wrap"
    Margin="0,5,0,15"/>


                    <!-- BUTTON -->

                    <Button
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Content="Create Gateway"
                        Height="50"
                        Command="{Binding CreateGatewayCommand}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Style="{StaticResource BaseButtonStyle}"/>

                </Grid>

            </Border>


            <!-- EXISTING GATEWAYS -->

            <StackPanel
                Grid.Row="2"
                Margin="0,30,0,0">

                <TextBlock
                    Text="Your Gateways"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#20242A"
                    Margin="0,0,0,15"/>

                <ItemsControl
                    ItemsSource="{Binding Gateways}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Border
                                Background="White"
                                CornerRadius="14"
                                Padding="20"
                                Margin="0,0,0,12">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock
                                            Text="{Binding Name}"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="#20242A"/>

                                        <TextBlock
                                            Text="{Binding Description}"
                                            Foreground="#707780"
                                            Margin="0,5,0,0"/>

                                        <TextBlock
                                            Text="{Binding SerialNumber, StringFormat=Serial: {0}}"
                                            Foreground="#707780"
                                            Margin="0,8,0,0"/>

                                        <TextBlock
                                            Text="{Binding IpAddress, StringFormat=IP: {0}}"
                                            Foreground="#707780"/>

                                    </StackPanel>

                                    <Border
                                        Grid.Column="1"
                                        Background="#E8F5E9"
                                        CornerRadius="12"
                                        Padding="12,6"
                                        VerticalAlignment="Top">

                                        <TextBlock
                                            Text="Active"
                                            Foreground="#2E7D32"
                                            FontWeight="SemiBold"/>

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Page>