<Page x:Class="SmartX.WPF.Views.Pages.Gateway.GatewayEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Edit Gateway"
      Background="{StaticResource BackgroundBrush}"
                      PreviewKeyDown="Page_PreviewKeyDown">


    <ScrollViewer
        VerticalScrollBarVisibility="Auto">

        <Grid Margin="60">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->

            <StackPanel Grid.Row="0">

                <TextBlock
                    Text="Edit Gateway"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#20242A"/>

                <TextBlock
                    Text="Update the configuration and information for this gateway."
                    FontSize="14"
                    Foreground="#707780"
                    Margin="0,8,0,30"/>

            </StackPanel>


            <!-- FORM -->

            <Border
                Grid.Row="1"
                Background="White"
                CornerRadius="18"
                Padding="35">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- NAME -->

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,18">

                        <TextBlock
                            Text="Gateway name"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- SERIAL -->

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="12,0,0,18">

                        <TextBlock
                            Text="Serial number"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding SerialNumber, UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- IP -->

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,12,18">

                        <TextBlock
                            Text="IP address"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- DESCRIPTION -->

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,0,0,18">

                        <TextBlock
                            Text="Description"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- ACTIVE -->

                    <StackPanel
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Margin="0,5,0,20">

                        <CheckBox
                            IsChecked="{Binding IsActive, Mode=TwoWay}"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Text="Gateway is active"
                            FontSize="14"
                            Foreground="#30343A"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"/>

                    </StackPanel>


                    <!-- STATUS -->

                    <TextBlock
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Text="{Binding StatusMessage}"
                        Foreground="#C62828"
                        FontSize="13"
                        TextWrapping="Wrap"
                        Margin="0,5,0,15"/>


                    <!-- BUTTONS -->

                    <Grid
                        Grid.Row="4"
                        Grid.ColumnSpan="2">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <Button
                            Grid.Column="0"
                            Content="Cancel"
                            Height="50"
                            Command="{Binding CancelCommand}"
                            FontSize="15"
                            Margin="0,0,10,0"
                            Style="{StaticResource BaseButtonStyle}"/>


                        <Button
                            Grid.Column="1"
                            Content="Save Changes"
                            Height="50"
                            Width="160"
                            Command="{Binding SaveCommand}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Margin="0,0,10,0"
                            Style="{StaticResource BaseButtonStyle}"/>


                        <Button
                            Grid.Column="2"
                            Content="Delete Gateway"
                            Height="50"
                            Width="160"
                            Command="{Binding DeleteCommand}"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Background="#C62828"
                            Foreground="White"/>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>