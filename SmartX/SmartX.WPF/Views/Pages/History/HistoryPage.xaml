<Page x:Class="SmartX.WPF.Views.Pages.History.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:SmartX.WPF.Views.Controls"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d"
      Title="History"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>


        <!-- CARD -->

        <Style x:Key="HistoryCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="15"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>

        <!-- FIELD LABEL -->

        <Style x:Key="HistoryLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource DarkBrush}"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

        </Style>


        <!-- METRIC BUTTON -->

        <Style x:Key="MetricButtonStyle"
               TargetType="RadioButton">

            <Setter Property="Background"
                    Value="#F3F5F7"/>

            <Setter Property="Foreground"
                    Value="{StaticResource DarkBrush}"/>

            <Setter Property="BorderBrush"
                    Value="#E1E5E8"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="15,8"/>

            <Setter Property="Margin"
                    Value="0,0,7,0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Page.Resources>


    <!-- PAGE -->
    <ScrollViewer
        x:Name="HistoryScrollViewer"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <Border Margin="20"
            Padding="25"
            Background="{StaticResource DarkBrush}"
            CornerRadius="24">

            <Grid Margin="10">
                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- HEADER -->

                <Grid Grid.Row="0">

                    <StackPanel>

                        <TextBlock Text="History"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="{StaticResource LightTextBrush}"
                           HorizontalAlignment="Center"/>

                        <TextBlock Text="Review historical sensor readings and telemetry."
                           FontSize="18"
                           Foreground="{StaticResource LightTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

                    </StackPanel>


                    <!-- Refresh -->

                    <Button Content="Refresh"
                    HorizontalAlignment="Right"
                    Width="95"
                    Height="38"
                    Cursor="Hand"
                    Style="{StaticResource SecondColourButtonStyle}"
                    Command="{Binding LoadCommand}"/>

                </Grid>

                <!-- FILTER BAR -->

                <Border Grid.Row="1"
                Style="{StaticResource HistoryCardStyle}"
                Margin="0,30,0,25">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="2.2*"/>

                            <ColumnDefinition Width="1.2*"/>

                            <ColumnDefinition Width="1.2*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <!-- SENSOR -->

                        <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">

                            <TextBlock Text="Sensor"
                               Style="{StaticResource HistoryLabelStyle}"/>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="220"/>

                                </Grid.ColumnDefinitions>


                                <!-- Sensor search -->

                                <TextBox Grid.Column="0"
                                 Height="38"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Text="{Binding SensorSearchText,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search sensors"/>


                                <!-- Sensor selector -->

                                <ComboBox Grid.Column="1"
                                  Height="38"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding FilteredSensors}"
                                  SelectedValue="{Binding SelectedSensorId,
                                                          Mode=TwoWay}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  ToolTip="Select sensor"/>

                            </Grid>

                        </StackPanel>


                        <!-- FROM -->

                        <StackPanel Grid.Column="1"
                            Margin="0,0,15,0">

                            <TextBlock Text="From"
                               Style="{StaticResource HistoryLabelStyle}"/>

                            <DatePicker Height="38"
                                SelectedDate="{Binding FromDate,
                                                       Mode=TwoWay}"/>

                        </StackPanel>


                        <!-- TO -->

                        <StackPanel Grid.Column="2"
                            Margin="0,0,15,0">

                            <TextBlock Text="To"
                               Style="{StaticResource HistoryLabelStyle}"/>

                            <DatePicker Height="38"
                                SelectedDate="{Binding ToDate,
                                                       Mode=TwoWay}"/>

                        </StackPanel>


                        <!-- CLEAR -->

                        <StackPanel Grid.Column="3"
                            VerticalAlignment="Bottom">

                            <Button Content="Clear"
                            Height="38"
                            Width="85"
                            Cursor="Hand"
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding ClearFiltersCommand}"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- MAIN CONTENT -->

                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2.2*"/>

                        <ColumnDefinition Width="20"/>

                        <ColumnDefinition Width="1*"/>

                    </Grid.ColumnDefinitions>


                    <!-- LEFT SIDE -->

                    <Grid Grid.Column="0">

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="330"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- TELEMETRY HEADER -->

                        <Border Grid.Row="0"
                        Style="{StaticResource HistoryCardStyle}"
                        Padding="20">

                            <Grid>

                                <StackPanel>

                                    <TextBlock Text="Telemetry"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"/>

                                    <TextBlock Text="Select a measurement to view its history."
                                    FontSize="12"
                                     Foreground="{StaticResource DarkBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0"/>
                                </StackPanel>

                            </Grid>

                        </Border>



                        <!-- GRAPH -->

                        <Border Grid.Row="1"
                    Style="{StaticResource HistoryCardStyle}"
                    Padding="18">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>


                                <!-- GRAPH HEADER -->

                                <Grid Grid.Row="0"
                            Margin="0,0,0,12">

                                    <StackPanel>

                                        <TextBlock Text="{Binding GraphMetricName}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DarkBrush}"/>

                                        <TextBlock Text="{Binding GraphUnit,
                                           StringFormat=Unit: {0}}"
                                        FontSize="14"
                                        Foreground="{StaticResource DarkBrush}"
                                        Margin="0,3,0,0"/>

                                    </StackPanel>


                                    <!-- Graph controls -->

                                    <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                        <!-- Power -->

                                        <RadioButton Content="Power"
                                        GroupName="TelemetryMetric"
                                        Margin="0,0,6,0"
                                        Padding="14,7"
                                        FontSize="14"
                                        Foreground="{StaticResource DarkBrush}"
                                        IsChecked="{Binding IsPowerSelected}"
                                        Style="{StaticResource MetricButtonStyle}"/>


                                        <!-- Temperature -->

                                        <RadioButton Content="Temperature"
                                        GroupName="TelemetryMetric"
                                        Margin="0,0,6,0"
                                        Padding="14,7"
                                        FontSize="14"
                                        Foreground="{StaticResource DarkBrush}"
                                        IsChecked="{Binding IsTemperatureSelected}"
                                        Style="{StaticResource MetricButtonStyle}"/>


                                        <!-- Voltage -->

                                        <RadioButton Content="Voltage"
                                        GroupName="TelemetryMetric"
                                        Margin="0,0,6,0"
                                        Padding="14,7"
                                        FontSize="14"
                                        Foreground="{StaticResource DarkBrush}"
                                        IsChecked="{Binding IsVoltageSelected}"
                                        Style="{StaticResource MetricButtonStyle}"/>


                                        <!-- Current -->

                                        <RadioButton Content="Current"
                                        GroupName="TelemetryMetric"
                                        Padding="14,7"
                                        FontSize="14"
                                        Foreground="{StaticResource DarkBrush}"
                                        IsChecked="{Binding IsCurrentSelected}"
                                        Style="{StaticResource MetricButtonStyle}"/>


                                        <!-- Zoom Out -->

                                        <Button Content="−"
                                        Width="35"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        FontSize="18"
                                        ToolTip="Zoom out"
                                        Click="ZoomOut_Click"/>

                                        <!-- Zoom In -->

                                        <Button Content="+"
                                        Width="35"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        FontSize="18"
                                        ToolTip="Zoom in"
                                        Click="ZoomIn_Click"/>

                                        <!-- Reset -->

                                        <Button Content="Reset"
                                        Width="55"
                                        Height="32"
                                        ToolTip="Reset zoom"
                                        Click="ResetZoom_Click"/>

                                    </StackPanel>

                                </Grid>


                                <!-- ACTUAL CHART -->

                                <lvc:CartesianChart
                                x:Name="HistoryChart"
                                Grid.Row="1"
                                Series="{Binding GraphSeries}"
                                XAxes="{Binding GraphXAxes}"
                                YAxes="{Binding GraphYAxes}"
                                ZoomMode="X"
                                PreviewMouseWheel="HistoryChart_PreviewMouseWheel"
                                PreviewMouseLeftButtonDown="HistoryChart_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="HistoryChart_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="HistoryChart_PreviewMouseLeftButtonUp"
                                TooltipPosition="Top"
                                LegendPosition="Hidden"
                                AnimationsSpeed="00:00:00.200"
                                Background="Transparent"/>

                            </Grid>

                        </Border>


                        <!-- STATISTICS -->

                        <Grid Grid.Row="3">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="12"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="12"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- Average -->

                            <Border Grid.Column="0"
                         Style="{StaticResource HistoryCardStyle}">

                                <StackPanel>

                                    <TextBlock Text="Average"
                                    FontSize="14"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"/>

                                    <TextBlock Text="{Binding AverageDisplay}"
                                    FontSize="23"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"
                                    Margin="0,6,0,0"/>

                                    <TextBlock Text="{Binding GraphMetricName}"
                                    FontSize="12"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"
                                    Margin="0,3,0,0"/>

                                </StackPanel>

                            </Border>


                            <!-- Maximum -->

                            <Border Grid.Column="2"
                             Style="{StaticResource HistoryCardStyle}">

                                <StackPanel>

                                    <TextBlock Text="Maximum"
                                    FontSize="14"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"/>

                                    <TextBlock Text="{Binding MaximumDisplay}"
                                    FontSize="23"
                                    HorizontalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DarkBrush}"
                                    Margin="0,6,0,0"/>

                                    <TextBlock Text="{Binding GraphMetricName}"
                                    FontSize="12"
                                    Foreground="{StaticResource DarkBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,3,0,0"/>

                                </StackPanel>

                            </Border>


                            <!-- Minimum -->

                            <Border Grid.Column="4"
                            Style="{StaticResource HistoryCardStyle}">

                                <StackPanel>

                                    <TextBlock Text="Minimum"
                                    FontSize="14"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"/>

                                    <TextBlock Text="{Binding MinimumDisplay}"
                                    FontSize="23"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"
                                    Margin="0,6,0,0"/>

                                    <TextBlock Text="{Binding GraphMetricName}"
                                    FontSize="12"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"
                                    Margin="0,3,0,0"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                        <!-- PREDICTIVE INSIGHTS -->


                        <!-- HISTORY TABLE -->

                        <Border Grid.Row="7"
                        Style="{StaticResource HistoryCardStyle}"
                        Padding="20">

                            <Grid>

                                <Grid.RowDefinitions>

                                    <RowDefinition Height="Auto"/>

                                    <RowDefinition Height="*"/>

                                </Grid.RowDefinitions>


                                <!-- Table header -->

                                <Grid Grid.Row="0">

                                    <StackPanel>

                                        <TextBlock Text="Historical Readings"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource DarkBrush}"/>

                                        <TextBlock Text="Sensor measurements recorded by SmartX"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource DarkBrush}"
                                           Margin="0,4,0,0"/>

                                    </StackPanel>


                                    <Button Content="Export"
                                    HorizontalAlignment="Right"
                                    Width="90"
                                    Height="36"
                                    Cursor="Hand"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Command="{Binding ExportCsvCommand}"/>

                                </Grid>


                                <!-- Data -->

                                <DataGrid Grid.Row="1"
                                Height="300"
                                Margin="0,18,0,0"
                                ItemsSource="{Binding History}"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                BorderThickness="1"
                                BorderBrush="#E1E5E8"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column">

                                    <DataGrid.Columns>

                                        <DataGridTextColumn
                                        Header="Date"
                                        Binding="{Binding Timestamp,
                                            StringFormat={}{0:yyyy-MM-dd}}"
                                        Width="1.2*"/>

                                        <DataGridTextColumn
                                        Header="Time"
                                        Binding="{Binding Timestamp,
                                            StringFormat={}{0:HH:mm:ss}}"
                                        Width="1.2*"/>

                                        <DataGridTextColumn
                                        Header="Sensor"
                                        Binding="{Binding SensorName}"
                                        Width="1.5*"/>

                                        <DataGridTextColumn
                                        Header="Voltage"
                                        Binding="{Binding Voltage,
                                        StringFormat={}{0:F2} V}"
                                        Width="*"/>

                                        <DataGridTextColumn
                                        Header="Current"
                                        Binding="{Binding Current,
                                        StringFormat={}{0:F2} A}"
                                        Width="*"/>

                                        <DataGridTextColumn
                                        Header="Power"
                                        Binding="{Binding Power,
                                        StringFormat={}{0:F2} W}"
                                        Width="*"/>

                                        <DataGridTextColumn
                                        Header="Temperature"
                                        Binding="{Binding Temperature,
                                        StringFormat={}{0:F2} °C}"
                                        Width="*"/>

                                    </DataGrid.Columns>

                                </DataGrid>

                            </Grid>

                        </Border>

                    </Grid>


                    <!-- RIGHT SIDE: PREDICTIVE ANALYSIS -->


                    <Border Grid.Column="2"
        Style="{StaticResource HistoryCardStyle}"
        Padding="20">

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="Predictive Analysis"
                       FontSize="23"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource DarkBrush}"/>

                                <TextBlock Text="AI-powered sensor anomaly detection and recommendations."
                       FontSize="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,8,0,20"
                       Foreground="#737A82"/>

                                <Separator/>

                                <TextBlock Text="Analysis Status"
                       FontWeight="SemiBold"
                       Margin="0,15,0,5"/>

                                <TextBlock Text="{Binding PredictionMessage}"
                       TextWrapping="Wrap"
                       Foreground="#737A82"/>

                                <TextBlock Text="Detected Anomaly"
                       FontWeight="SemiBold"
                       Margin="0,20,0,5"/>

                                <Border Background="#F8F9FA"
                    CornerRadius="8"
                    Padding="12">

                                    <TextBlock Text="{Binding AnomalyDescription}"
                           TextWrapping="Wrap"/>
                                </Border>

                                <TextBlock Text="Recommendation Reason"
                       FontWeight="SemiBold"
                       Margin="0,18,0,5"/>

                                <TextBlock Text="{Binding RecommendationReason}"
                       TextWrapping="Wrap"/>

                                <TextBlock Text="Suggested Command"
                       FontWeight="SemiBold"
                       Margin="0,18,0,5"/>

                                <TextBox Text="{Binding RecommendedCommand, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     MinHeight="45"
                     Padding="10"
                     FontFamily="Consolas"
                     Background="#F8F9FA"/>

                                <TextBlock Text="Recommendation Status"
                       FontWeight="SemiBold"
                       Margin="0,18,0,5"/>

                                <TextBlock Text="{Binding RecommendationStatus}"
                       TextWrapping="Wrap"/>

                                <Button Content="Analyse Sensor"
                    Height="42"
                    Margin="0,20,0,0"
                    Style="{StaticResource BaseButtonStyle}"
                    Command="{Binding AnalyzeAnomalyCommand}"/>

                                <Button Content="Load Predictive Suggestions"
                    Height="42"
                    Margin="0,10,0,0"
                    Style="{StaticResource BaseButtonStyle}"
                    Command="{Binding LoadPredictiveSuggestionsCommand}"/>

                                <Button Content="Send to Real-Time Command Centre"
                    Height="45"
                    Margin="0,10,0,0"
                    Style="{StaticResource BaseButtonStyle}"
                    Command="{Binding SendToCommandCentreCommand}"/>

                                <TextBlock Text="Commands are transferred for review and are not executed automatically."
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0"
                       Foreground="#737A82"/>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>



                </Grid>

            </Grid>
        </Border>
    </ScrollViewer>

</Page>
