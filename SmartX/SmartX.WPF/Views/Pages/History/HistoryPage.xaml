<Page x:Class="SmartX.WPF.Views.Pages.History.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:SmartX.WPF.Views.Controls"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      mc:Ignorable="d"
      Title="History"
      Background="{StaticResource BackgroundBrush}">

    <Page.Resources>

        <!-- CARD -->

        <Style x:Key="HistoryCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="15"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>

        <!-- FIELD LABEL -->

        <Style x:Key="HistoryLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="15"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="{StaticResource DarkBrush}"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

        </Style>


        <!-- METRIC BUTTON -->

        <Style x:Key="MetricButtonStyle"
               TargetType="RadioButton">

            <Setter Property="Background"
                    Value="#F3F5F7"/>

            <Setter Property="Foreground"
                    Value="{StaticResource DarkBrush}"/>

            <Setter Property="BorderBrush"
                    Value="#E1E5E8"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="15,8"/>

            <Setter Property="Margin"
                    Value="0,0,7,0"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Page.Resources>


    <!-- PAGE -->
    <ScrollViewer
        x:Name="HistoryScrollViewer"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="35">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>

            <!-- HEADER -->

            <Grid Grid.Row="0">

                <StackPanel>

                    <TextBlock Text="History"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="{StaticResource LightTextBrush}"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="Review historical sensor readings and telemetry."
                           FontSize="18"
                           Foreground="{StaticResource LightTextBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,6,0,0"/>

                </StackPanel>


                <!-- Refresh -->

                <Button Content="Refresh"
                    HorizontalAlignment="Right"
                    Width="95"
                    Height="38"
                    Cursor="Hand"
                    Style="{StaticResource BaseButtonStyle}"
                    Command="{Binding LoadCommand}"/>

            </Grid>

            <!-- FILTER BAR -->

            <Border Grid.Row="1"
                Style="{StaticResource HistoryCardStyle}"
                Margin="0,30,0,25">

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2.2*"/>

                        <ColumnDefinition Width="1.2*"/>

                        <ColumnDefinition Width="1.2*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <!-- SENSOR -->

                    <StackPanel Grid.Column="0"
                            Margin="0,0,20,0">

                        <TextBlock Text="Sensor"
                               Style="{StaticResource HistoryLabelStyle}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="220"/>

                            </Grid.ColumnDefinitions>


                            <!-- Sensor search -->

                            <TextBox Grid.Column="0"
                                 Height="38"
                                 Padding="12,0"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Text="{Binding SensorSearchText,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search sensors"/>


                            <!-- Sensor selector -->

                            <ComboBox Grid.Column="1"
                                  Height="38"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding FilteredSensors}"
                                  SelectedValue="{Binding SelectedSensorId,
                                                          Mode=TwoWay}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"
                                  ToolTip="Select sensor"/>

                        </Grid>

                    </StackPanel>


                    <!-- FROM -->

                    <StackPanel Grid.Column="1"
                            Margin="0,0,15,0">

                        <TextBlock Text="From"
                               Style="{StaticResource HistoryLabelStyle}"/>

                        <DatePicker Height="38"
                                SelectedDate="{Binding FromDate,
                                                       Mode=TwoWay}"/>

                    </StackPanel>


                    <!-- TO -->

                    <StackPanel Grid.Column="2"
                            Margin="0,0,15,0">

                        <TextBlock Text="To"
                               Style="{StaticResource HistoryLabelStyle}"/>

                        <DatePicker Height="38"
                                SelectedDate="{Binding ToDate,
                                                       Mode=TwoWay}"/>

                    </StackPanel>


                    <!-- CLEAR -->

                    <StackPanel Grid.Column="3"
                            VerticalAlignment="Bottom">

                        <Button Content="Clear"
                            Height="38"
                            Width="85"
                            Cursor="Hand"
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding ClearFiltersCommand}"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- MAIN CONTENT -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2.2*"/>

                    <ColumnDefinition Width="20"/>

                    <ColumnDefinition Width="1*"/>

                </Grid.ColumnDefinitions>


                <!-- LEFT SIDE -->

                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="330"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>


                    <!-- TELEMETRY HEADER -->

                    <Border Grid.Row="0"
                        Style="{StaticResource HistoryCardStyle}"
                        Padding="20">

                        <Grid>

                            <StackPanel>

                                <TextBlock Text="Telemetry"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"/>

                                <TextBlock Text="Select a measurement to view its history."
                                    FontSize="12"
                                     Foreground="{StaticResource DarkBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,4,0,0"/>
                            </StackPanel>

                        </Grid>

                    </Border>



                    <!-- GRAPH -->

                    <Border Grid.Row="1"
                    Style="{StaticResource HistoryCardStyle}"
                    Padding="18">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>


                            <!-- GRAPH HEADER -->

                            <Grid Grid.Row="0"
                            Margin="0,0,0,12">

                                <StackPanel>

                                    <TextBlock Text="{Binding GraphMetricName}"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource DarkBrush}"/>

                                    <TextBlock Text="{Binding GraphUnit,
                                           StringFormat=Unit: {0}}"
                                        FontSize="14"
                                        Foreground="{StaticResource DarkBrush}"
                                        Margin="0,3,0,0"/>

                                </StackPanel>


                                <!-- Graph controls -->

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">

                                    <!-- Power -->

                                    <RadioButton Content="Power"
                                        GroupName="TelemetryMetric"
                                        Margin="0,0,6,0"
                                        Padding="14,7"
                                        FontSize="14"
                                        Foreground="{StaticResource DarkBrush}"
                                        IsChecked="{Binding IsPowerSelected}"
                                        Style="{StaticResource MetricButtonStyle}"/>


                                    <!-- Temperature -->

                                    <RadioButton Content="Temperature"
                                        GroupName="TelemetryMetric"
                                        Margin="0,0,6,0"
                                        Padding="14,7"
                                        FontSize="14"
                                        Foreground="{StaticResource DarkBrush}"
                                        IsChecked="{Binding IsTemperatureSelected}"
                                        Style="{StaticResource MetricButtonStyle}"/>


                                    <!-- Voltage -->

                                    <RadioButton Content="Voltage"
                                        GroupName="TelemetryMetric"
                                        Margin="0,0,6,0"
                                        Padding="14,7"
                                        FontSize="14"
                                        Foreground="{StaticResource DarkBrush}"
                                        IsChecked="{Binding IsVoltageSelected}"
                                        Style="{StaticResource MetricButtonStyle}"/>


                                    <!-- Current -->

                                    <RadioButton Content="Current"
                                        GroupName="TelemetryMetric"
                                        Padding="14,7"
                                        FontSize="14"
                                        Foreground="{StaticResource DarkBrush}"
                                        IsChecked="{Binding IsCurrentSelected}"
                                        Style="{StaticResource MetricButtonStyle}"/>


                                    <!-- Zoom Out -->

                                    <Button Content="−"
                                        Width="35"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        FontSize="18"
                                        ToolTip="Zoom out"
                                        Click="ZoomOut_Click"/>

                                    <!-- Zoom In -->

                                    <Button Content="+"
                                        Width="35"
                                        Height="32"
                                        Margin="0,0,4,0"
                                        FontSize="18"
                                        ToolTip="Zoom in"
                                        Click="ZoomIn_Click"/>

                                    <!-- Reset -->

                                    <Button Content="Reset"
                                        Width="55"
                                        Height="32"
                                        ToolTip="Reset zoom"
                                        Click="ResetZoom_Click"/>

                                </StackPanel>

                            </Grid>


                            <!-- ACTUAL CHART -->

                            <lvc:CartesianChart
                                x:Name="HistoryChart"
                                Grid.Row="1"
                                Series="{Binding GraphSeries}"
                                XAxes="{Binding GraphXAxes}"
                                YAxes="{Binding GraphYAxes}"
                                ZoomMode="X"
                                PreviewMouseWheel="HistoryChart_PreviewMouseWheel"
                                PreviewMouseLeftButtonDown="HistoryChart_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="HistoryChart_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="HistoryChart_PreviewMouseLeftButtonUp"
                                TooltipPosition="Top"
                                LegendPosition="Hidden"
                                AnimationsSpeed="00:00:00.200"
                                Background="Transparent"/>

                        </Grid>

                    </Border>


                    <!-- STATISTICS -->

                    <Grid Grid.Row="3">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="12"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <!-- Average -->

                        <Border Grid.Column="0"
                         Style="{StaticResource HistoryCardStyle}">

                            <StackPanel>

                                <TextBlock Text="Average"
                                    FontSize="14"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"/>

                                <TextBlock Text="{Binding AverageDisplay}"
                                    FontSize="23"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"
                                    Margin="0,6,0,0"/>

                                <TextBlock Text="{Binding GraphMetricName}"
                                    FontSize="12"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"
                                    Margin="0,3,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- Maximum -->

                        <Border Grid.Column="2"
                             Style="{StaticResource HistoryCardStyle}">

                            <StackPanel>

                                <TextBlock Text="Maximum"
                                    FontSize="14"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"/>

                                <TextBlock Text="{Binding MaximumDisplay}"
                                    FontSize="23"
                                    HorizontalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource DarkBrush}"
                                    Margin="0,6,0,0"/>

                                <TextBlock Text="{Binding GraphMetricName}"
                                    FontSize="12"
                                    Foreground="{StaticResource DarkBrush}"
                                    HorizontalAlignment="Center"
                                    Margin="0,3,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- Minimum -->

                        <Border Grid.Column="4"
                            Style="{StaticResource HistoryCardStyle}">

                            <StackPanel>

                                <TextBlock Text="Minimum"
                                    FontSize="14"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"/>

                                <TextBlock Text="{Binding MinimumDisplay}"
                                    FontSize="23"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"
                                    Margin="0,6,0,0"/>

                                <TextBlock Text="{Binding GraphMetricName}"
                                    FontSize="12"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource DarkBrush}"
                                    Margin="0,3,0,0"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- PREDICTIVE INSIGHTS -->
                    

                    <!-- HISTORY TABLE -->

                    <Border Grid.Row="7"
                        Style="{StaticResource HistoryCardStyle}"
                        Padding="20">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>


                            <!-- Table header -->

                            <Grid Grid.Row="0">

                                <StackPanel>

                                    <TextBlock Text="Historical Readings"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource DarkBrush}"/>

                                    <TextBlock Text="Sensor measurements recorded by SmartX"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource DarkBrush}"
                                           Margin="0,4,0,0"/>

                                </StackPanel>


                                <Button Content="Export"
                                    HorizontalAlignment="Right"
                                    Width="90"
                                    Height="36"
                                    Cursor="Hand"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Command="{Binding ExportCommand}"/>

                            </Grid>


                            <!-- Data -->

                            <DataGrid Grid.Row="1"
                                Height="300"
                                Margin="0,18,0,0"
                                ItemsSource="{Binding History}"
                                AutoGenerateColumns="False"
                                IsReadOnly="True"
                                CanUserAddRows="False"
                                BorderThickness="1"
                                BorderBrush="#E1E5E8"
                                GridLinesVisibility="Horizontal"
                                HeadersVisibility="Column">

                                <DataGrid.Columns>

                                    <DataGridTextColumn
                                        Header="Date"
                                        Binding="{Binding Timestamp,
                                            StringFormat={}{0:yyyy-MM-dd}}"
                                        Width="1.2*"/>

                                    <DataGridTextColumn
                                        Header="Time"
                                        Binding="{Binding Timestamp,
                                            StringFormat={}{0:HH:mm:ss}}"
                                        Width="1.2*"/>

                                    <DataGridTextColumn
                                        Header="Sensor"
                                        Binding="{Binding SensorName}"
                                        Width="1.5*"/>

                                    <DataGridTextColumn
                                        Header="Voltage"
                                        Binding="{Binding Voltage,
                                        StringFormat={}{0:F2} V}"
                                        Width="*"/>

                                    <DataGridTextColumn
                                        Header="Current"
                                        Binding="{Binding Current,
                                        StringFormat={}{0:F2} A}"
                                        Width="*"/>

                                    <DataGridTextColumn
                                        Header="Power"
                                        Binding="{Binding Power,
                                        StringFormat={}{0:F2} W}"
                                        Width="*"/>

                                    <DataGridTextColumn
                                        Header="Temperature"
                                        Binding="{Binding Temperature,
                                        StringFormat={}{0:F2} °C}"
                                        Width="*"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </Border>

                </Grid>

                <!-- RIGHT SIDE -->

                <Border Grid.Column="2"
                    Style="{StaticResource HistoryCardStyle}">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="16"/>

                            <RowDefinition Height="*"/>
                            
                            <RowDefinition Height="Auto"/>

                        </Grid.RowDefinitions>


                        <!-- Command history header -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Command History"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource DarkBrush}"/>

                                <TextBlock Text="Previously sent commands."
                   FontSize="11"
                   Foreground="#8A929A"
                   Margin="0,3,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
            Content="Undo Last"
            MinWidth="90"
            Margin="10,0,6,0"
            Cursor="Hand"
            Style="{StaticResource BaseButtonStyle}"
            Command="{Binding UndoLastCommandCommand}"
            IsEnabled="{Binding CanUndoCommand}"/>

                            <Button Grid.Column="2"
            Content="Clear History"
            MinWidth="100"
            Margin="0,0,0,0"
            Cursor="Hand"
            Style="{StaticResource BaseButtonStyle}"
            Command="{Binding ClearCommandHistoryCommand}"/>
                        </Grid>


                        <!-- COMMAND INPUT -->

                        <Grid Grid.Row="1"
                          Margin="0,22,0,0">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="85"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <TextBlock Grid.Row="0"
                                   Text="Command"
                                   Style="{StaticResource HistoryLabelStyle}"/>


                            <TextBox Grid.Row="1"
                                 Text="{Binding ManualCommand,
                                                UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="12"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 BorderBrush="#DDE2E6"
                                 BorderThickness="1"
                                 ToolTip="Enter command for the selected sensor"/>


                            <Grid Grid.Row="2"
                              Margin="0,12,0,0">

                                <TextBlock Text="Command will be sent immediately."
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#8A929A"/>


                                <Button Content="Send Command"
                                    HorizontalAlignment="Right"
                                    Width="125"
                                    Height="38"
                                    Cursor="Hand"
                                    Style="{StaticResource BaseButtonStyle}"
                                    Command="{Binding SendManualCommandCommand}"/>

                            </Grid>

                        </Grid>

                        <!-- COMMAND HISTORY -->

                        <Border Grid.Row="3"
                            BorderBrush="#E6E9EC"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <!-- Error message -->
                                    <RowDefinition Height="Auto"/>

                                    <!-- Command list and empty state -->
                                    <RowDefinition Height="*"/>

                                    <!-- Bottom information -->
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>


                                <!-- Error message -->
                                <TextBlock Grid.Row="0"
                                    Text="{Binding ErrorMessage}"
                                    Foreground="Red"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,0"/>

                                <!-- Command list -->
                                <ListBox Grid.Row="1"
                                    Margin="0,12,0,10"
                                    ItemsSource="{Binding CommandHistory}"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Height="300"
                                    MaxHeight="300"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10"
                                                Margin="0,0,0,8"
                                                Background="#F8F9FA"
                                                CornerRadius="8">

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <!-- Command and timestamp -->
                                                    <Grid Grid.Row="0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                           Text="{Binding Command}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           Foreground="{StaticResource DarkBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,8,0"/>

                                                        <TextBlock Grid.Column="1"
                                           Text="{Binding Timestamp,
                                               StringFormat={}{0:HH:mm:ss}}"
                                           VerticalAlignment="Top"
                                           FontSize="10"
                                           Foreground="#9299A0"/>
                                                    </Grid>

                                                    <!-- Response -->
                                                    <TextBlock Grid.Row="1"
                                       Text="{Binding Response}"
                                       FontSize="11"
                                       Foreground="#737A82"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Empty state -->
                                <TextBlock Grid.Row="1"
                                    Text="No commands sent yet."
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="#A0A7AE"
                                    IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CommandHistory.Count}"
                                     Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Bottom information -->
                                <Border Grid.Row="2"
                                    Background="#FFF8E8"
                                    CornerRadius="7"
                                    Padding="10">

                                    <TextBlock Text="Manual commands are sent directly to the selected sensor. Use Undo Last to revert the most recent command."
                                        FontSize="11"
                                        Foreground="#856404"
                                        TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>
 
                        <!-- PREDICTIVE ANOMALY RECOMMENDATIONS -->
                        <Border Grid.Row="4"
                    Margin="0,16,0,0"
                    Padding="16"
                    Background="#F4F8FF"
                    BorderBrush="#D6E4FF"
                    BorderThickness="1"
                    CornerRadius="12">

                            <StackPanel>

                                <!-- Panel heading -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Predictive Insights"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DarkBrush}"/>

                                        <TextBlock Text="{Binding PredictionMessage,
                                                      TargetNullValue=Select a sensor to analyse its telemetry.}"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="#737A82"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                Background="#DCEBFF"
                                CornerRadius="6"
                                Padding="8,4"
                                VerticalAlignment="Top">

                                        <TextBlock Text="PREDICTIVE"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#2459A9"/>
                                    </Border>
                                </Grid>

                                <Separator Margin="0,0,0,12"
                               Background="#D6E4FF"/>

                                <!-- Detected anomaly -->
                                <TextBlock Text="Detected anomaly"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DarkBrush}"/>

                                <TextBlock Text="{Binding AnomalyDescription,
                                              TargetNullValue=No anomaly analysis available.}"
                               Margin="0,4,0,12"
                               FontSize="12"
                               Foreground="#535B65"
                               TextWrapping="Wrap"/>

                                <!-- Recommended action -->
                                <TextBlock Text="Suggested course of action"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DarkBrush}"/>

                                <TextBlock Text="{Binding RecommendedAction,
                                              TargetNullValue=No recommendation available.}"
                               Margin="0,4,0,12"
                               FontSize="12"
                               Foreground="#535B65"
                               TextWrapping="Wrap"/>

                                <!-- Suggested command -->
                                <TextBlock Text="Recommended command"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DarkBrush}"/>

                                <TextBox Text="{Binding RecommendedCommand,
                                            Mode=OneWay,
                                            TargetNullValue=''}"
                             Margin="0,6,0,12"
                             Padding="10,8"
                             FontFamily="Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="38"
                             MaxHeight="90"
                             BorderBrush="#D6E4FF"
                             Background="White"/>

                                <TextBlock Text="Available recommendations"
           Margin="0,6,0,2"
           FontSize="11"
           FontWeight="SemiBold"
           Foreground="#535B65"/>

                                <TextBlock Margin="0,0,0,12"
           FontSize="11"
           Foreground="#737A82"
           TextWrapping="Wrap"
           Text="INSPECT_COOLING — inspect ventilation and cooling.
INSPECT_LOAD — inspect equipment load.
INSPECT_VOLTAGE — verify the electrical supply.
These are advisory identifiers, not executable device commands. Only use commands supported by your device."
           />

                                <!-- Recommendation rationale -->
                                <TextBlock Text="{Binding RecommendationReason}"
                               Margin="0,0,0,12"
                               FontSize="11"
                               Foreground="#737A82"
                               TextWrapping="Wrap"/>

                                <!-- Explicit confirmation is handled by the command -->
                                <Button Content="Review and Apply Recommendation"
                            Height="38"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand"
                            Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding ApplyRecommendationCommand}"/>

                                <!-- Execution result / status -->
                                <TextBlock Text="{Binding RecommendationStatus}"
                               Margin="0,8,0,0"
                               FontSize="11"
                               Foreground="#535B65"
                               TextWrapping="Wrap"/>

                            </StackPanel>
                        </Border>
                    </Grid>

                </Border>

            </Grid>

        </Grid>
    </ScrollViewer>

</Page>
