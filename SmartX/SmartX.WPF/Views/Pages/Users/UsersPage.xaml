<Page x:Class="SmartX.WPF.Views.Pages.Users.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Users">

    <Grid Background="{StaticResource BackgroundBrush}">

        <!-- LIST MODE -->

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListMode}"
                                     Value="True">
                            <Setter Property="Visibility"
                                    Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- HEADER -->
            <Border Grid.Row="0"
        Background="{StaticResource BackgroundBrush}"
        Padding="24,20"

        BorderBrush="#E5E7EB"
        BorderThickness="0,0,0,1">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Users"
                       FontSize="30"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource LightTextBrush}"/>

                        <TextBlock Text="{Binding CurrentCompanyName}"
                       Margin="0,5,0,0"
                       HorizontalAlignment="Center"
                       FontSize="20"
                       Foreground="{StaticResource LightTextBrush}"
                       Opacity="0.8"/>
                    </StackPanel>

                    <WrapPanel Grid.Column="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Right">

                        <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource BaseButtonStyle}"
                    Padding="16,9"
                    Margin="0,0,8,0"/>

                        <Button Content="Edit User"
                    Command="{Binding EditUserCommand}"
                    IsEnabled="{Binding SelectedUser}"
                    Style="{StaticResource BaseButtonStyle}"
                    Padding="16,9"
                    Margin="0,0,8,0"/>

                        <Button Content="+ Add User"
                    Command="{Binding AddUserCommand}"
                    Style="{StaticResource BaseButtonStyle}"
                    Padding="16,9"
                    Margin="0,0,8,0"/>

                        <Button Content="Delete User"
                    Command="{Binding DeleteUserCommand}"
                    IsEnabled="{Binding SelectedUser}"
                    Style="{StaticResource BaseButtonStyle}"
                    Padding="16,9"/>

                    </WrapPanel>
                </Grid>
            </Border>


            <!-- FILTER BAR -->
            <Border Grid.Row="1"
                    Margin="24,15,24,10"
                    Padding="16"
                    Background="White"
                    CornerRadius="8">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.4*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Company -->
                    <StackPanel Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,12">

                        <TextBlock Text="Company"
                            Style="{StaticResource BodyTextStyleBlack}"
                            Margin="0,0,0,5"/>

                        <ComboBox Grid.Row="1"
                            ItemsSource="{Binding Companies}"
                            SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"
                            DisplayMemberPath="Name"
                            Height="36">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox"
                                    BasedOn="{StaticResource BaseComboBoxStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuperAdmin}"
                                            Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>

                        <TextBlock Text="{Binding CurrentCompanyName}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MinHeight="36">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuperAdmin}"
                                     Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <!-- Name -->
                    <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Margin="0,0,12,12">
                        <TextBlock Text="Name"
                             Style="{StaticResource BodyTextStyleBlack}"
                            Margin="0,0,0,5"/>

                        <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                            Height="36"
                            HorizontalContentAlignment="Center"
                            Padding="10,6"/>
                    </StackPanel>

                    <!-- Email -->
                    <StackPanel Grid.Row="0"
                         Grid.Column="2"
                        Margin="0,0,0,12">
                        <TextBlock Text="Email"
                            Style="{StaticResource BodyTextStyleBlack}"
                            Margin="0,0,0,5"/>

                        <TextBox Text="{Binding EmailFilter, UpdateSourceTrigger=PropertyChanged}"
                            Height="36"
                            HorizontalContentAlignment="Center"
                            Padding="10,6"/>
                    </StackPanel>

                    <!-- Role -->
                    <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,12,0">
                        <TextBlock Text="Role"
                            Style="{StaticResource BodyTextStyleBlack}"
                            Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding RoleFilters}"
                            SelectedItem="{Binding SelectedRoleFilter, Mode=TwoWay}"
                            Style="{StaticResource BaseComboBoxStyle}"
                        HorizontalContentAlignment="Center"
                        FontSize="20"
                        Height="36"/>
                    </StackPanel>

                    <!-- Status -->
                    <StackPanel Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,0,12,0">
                        
                        <TextBlock Text="Status"
                            Style="{StaticResource BodyTextStyleBlack}"
                            Margin="0,0,0,5"/>

                        <ComboBox ItemsSource="{Binding StatusFilters}"
                            SelectedItem="{Binding StatusFilter, Mode=TwoWay}"
                            Style="{StaticResource BaseComboBoxStyle}"
                            Height="36"
                            HorizontalContentAlignment="Center"
                        FontSize="20"/>
                    </StackPanel>

                    <!-- Clear -->
                    <Button Grid.Row="1"
                        Grid.Column="2"
                        Content="Clear filters"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        Padding="16,8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"/>
                </Grid>

            </Border>


            <!-- SUMMARY -->
            <Grid Grid.Row="2"
                  Margin="24,0,24,10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <!-- TOTAL -->
                <Border Grid.Column="0"
                    Style="{StaticResource ElevatedCardStyle}"
                    Margin="0,0,8,0"
                    Padding="18">
                    <StackPanel>
                        <TextBlock Text="Total Users"
                            Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock Text="{Binding TotalUsers}"
                   Margin="0,5,0,0"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource DarkBrush}"/>
                    </StackPanel>
                </Border>


                <!-- ACTIVE -->
                <Border Grid.Column="1"
                    Style="{StaticResource ElevatedCardStyle}"
                    Margin="0,0,8,0"
                    Padding="18">


                    <StackPanel>

                        <TextBlock Text="Active"
                            Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock Text="{Binding ActiveUsers}"
                                HorizontalAlignment="Center"
                                   Margin="0,5,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#16A34A"/>

                    </StackPanel>

                </Border>


                <!-- ADMINISTRATORS -->
                <Border Grid.Column="2"
                    Style="{StaticResource ElevatedCardStyle}"
                    Margin="0,0,8,0"
                    Padding="18">

                    <StackPanel>

                        <TextBlock Text="Administrators"
                            Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock Text="{Binding AdministratorCount}"
                                   Margin="0,5,0,0"
                                   FontSize="24"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Foreground="#7C3AED"/>

                    </StackPanel>

                </Border>


                <!-- TECHNICIANS -->
                <Border Grid.Column="3"
                         Style="{StaticResource ElevatedCardStyle}"
                    Margin="0,0,8,0"
                    Padding="18">

                    <StackPanel>

                        <TextBlock Text="Technicians"
                            Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock Text="{Binding TechnicianCount}"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#2563EB"/>

                    </StackPanel>

                </Border>


                <!-- VIEWERS -->
                <Border Grid.Column="4"
                          Style="{StaticResource ElevatedCardStyle}"
                    Margin="0"
                    Padding="18">

                    <StackPanel>

                        <TextBlock Text="Viewers"
                            Style="{StaticResource MutedTextStyle}"/>

                        <TextBlock Text="{Binding ViewerCount}"
                                   Margin="0,5,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#7C3AED"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- USERS TABLE -->
            <Border Grid.Row="3"
                    Margin="24,0,24,24"
                    Background="White"
                    CornerRadius="8"
                    Padding="1">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- ERROR -->
                    <TextBlock Grid.Row="0"
                         Text="{Binding ErrorMessage}"
                            Foreground="#DC2626"
                            Margin="16,8"
                            TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock"
                                BasedOn="{StaticResource BodyTextStyleBlack}">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}"
                                        Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding ErrorMessage}"
                                        Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding ErrorMessage}"
                                        Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>


                    <!-- TABLE -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredUsers}"
                              SelectedItem="{Binding SelectedUser}"
                              Background="White"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              Margin="5">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding DisplayName}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Role"
                                                Binding="{Binding Role}"
                                                Width="*"/>

                            <DataGridCheckBoxColumn Header="Active"
                                                    Binding="{Binding IsActive}"
                                                    Width="*"/>

                            <DataGridTextColumn Header="Created"
                                                Binding="{Binding CreatedAt,
                                                          StringFormat={}{0:yyyy-MM-dd}}"
                                                Width="*"/>

                        </DataGrid.Columns>


                        <!-- CONTEXT MENU -->
                        <DataGrid.ContextMenu>
                            <ContextMenu
                                DataContext="{Binding PlacementTarget.DataContext,
                                    RelativeSource={RelativeSource Self}}">

                                <MenuItem Header="Edit"
                                    Command="{Binding DataContext.EditUserCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>

                                <MenuItem Header="Delete"
                                    Command="{Binding DataContext.DeleteUserCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

        <!-- CREATE / EDIT MODE -->

        <Grid MaxWidth="500" HorizontalAlignment="Stretch">

            <Grid.Style>

                <Style TargetType="Grid">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                    <Style.Triggers>

                        <!-- CREATE -->
                        <DataTrigger Binding="{Binding IsCreateMode}"
                                     Value="True">

                            <Setter Property="Visibility"
                                    Value="Visible"/>

                        </DataTrigger>


                        <!-- EDIT -->
                        <DataTrigger Binding="{Binding IsEditMode}"
                                     Value="True">

                            <Setter Property="Visibility"
                                    Value="Visible"/>

                        </DataTrigger>

                    </Style.Triggers>

                </Style>

            </Grid.Style>


            <Grid Margin="24">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- FORM HEADER -->
                <Border Grid.Row="0"
                        Background="White"
                        Padding="28,22"
                        BorderBrush="#E5E7EB"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock FontSize="28"
                                       FontWeight="SemiBold"
                                       Foreground="#111827">

                                <TextBlock.Style>

                                    <Style TargetType="TextBlock">

                                        <Setter Property="Text"  Value="Create User"/>
                                        <Setter Property="HorizontalAlignment"  Value="Center"/>

                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding IsEditMode}"
                                                         Value="True">

                                                <Setter Property="Text"
                                                        Value="Edit User"/>
                                                <Setter Property="HorizontalAlignment"  Value="Center"/>


                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </TextBlock.Style>

                            </TextBlock>


                            <TextBlock Text="{Binding CurrentCompanyName}"
                                       Margin="0,5,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="20" 
                                       Foreground="#6B7280"/>

                        </StackPanel>




                    </Grid>

                </Border>


                <!-- FORM BODY -->
                <Border Grid.Row="1"
                        Background="White"
                        Padding="28"
                        CornerRadius="0,0,8,8">

                    <ScrollViewer VerticalScrollBarVisibility="Auto">

                        <Grid MaxWidth="700"
                              HorizontalAlignment="Center">

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>


                            </Grid.RowDefinitions>


                            <!-- DISPLAY NAME -->
                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,18">

                                <TextBlock Text="Display Name"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Margin="0,0,0,6"/>

                                <TextBox Text="{Binding FormDisplayName,  UpdateSourceTrigger=PropertyChanged}"
                                         
                                         Height="40"
                                         HorizontalContentAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         FontSize="18"
                                         Padding="5,7"/>

                            </StackPanel>


                            <!-- EMAIL -->
                            <StackPanel Grid.Row="1"
                                Margin="0,0,0,18">

                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">

                                        <!-- Visible by default -->
                                        <Setter Property="Visibility"
                                            Value="Visible"/>

                                        <Style.Triggers>

                                            <!-- Hide when editing -->
                                            <DataTrigger Binding="{Binding IsEditMode}"
                                                 Value="True">

                                                <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Email"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Margin="0,0,0,6"/>

                                <TextBox Text="{Binding FormEmail,
                                    UpdateSourceTrigger=PropertyChanged}"                                         Height="40"
                                         HorizontalContentAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         FontSize="18"
                                         Padding="5,7"/>

                            </StackPanel>


                            <!-- TEMPORARY PASSWORD -->
                            <StackPanel Grid.Row="2"
                                Margin="0,0,0,18">

                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">

                                        <!-- Visible by default -->
                                        <Setter Property="Visibility"
                                            Value="Visible"/>
                                        <Style.Triggers>

                                            <!-- Hide when editing -->
                                            <DataTrigger Binding="{Binding IsEditMode}"
                                                Value="True">

                                                <Setter Property="Visibility"
                                                    Value="Collapsed"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="Temporary Password"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Margin="0,0,0,6"/>

                                <TextBox Text="{Binding FormPassword,
                             UpdateSourceTrigger=PropertyChanged}"                                         Height="40"
                                         HorizontalContentAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         FontSize="18"
                                         Padding="5,7"/>

                                <TextBlock Text="This password is used when creating the user's Firebase account."
                                    FontSize="12"
                                    Foreground="#6B7280"
                                    Margin="0,5,0,0"
                                    TextWrapping="Wrap"/>

                            </StackPanel>


                            <!-- ROLE -->
                            <StackPanel Grid.Row="3"
                                        Margin="0,0,0,18">

                                <TextBlock Text="Role"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="#374151"
                                           Margin="0,0,0,6"/>

                                <ComboBox ItemsSource="{Binding AvailableRoles}"
                                          SelectedItem="{Binding FormRole, Mode=TwoWay}"                                         Height="40"
                                         HorizontalContentAlignment="Center"
                                         HorizontalAlignment="Stretch"
                                         FontSize="18"
                                         Padding="5,7"/>

                            </StackPanel>


                            <!-- ACTIVE -->
                            <CheckBox Grid.Row="4"
                                      Content="Active"
                                      IsChecked="{Binding FormIsActive, Mode=TwoWay}"
                                      FontSize="13"
                                      Foreground="#374151"
                                      Margin="0,0,0,24"/>


                            <!-- ERROR -->
                            <TextBlock Grid.Row="5"
                                       Text="{Binding ErrorMessage}"
                                       Foreground="#DC2626"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,18"/>


                            <!-- SAVE -->
                            <StackPanel Grid.Row="6"
                                        Orientation="Horizontal" HorizontalAlignment="Center">

                                <Button Content="Save User"
                                        Command="{Binding SaveUserCommand}"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Padding="22,10"
                                        Margin="0,0,10,0"/>

                                <Button Content="Cancel"
                                        Command="{Binding CancelCommand}"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Padding="22,10"/>

                            </StackPanel>

                        </Grid>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Grid>

    </Grid>

</Page>