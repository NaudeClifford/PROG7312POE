<Page x:Class="SmartX.WPF.Views.Pages.Sensor.SensorEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Edit Sensor"
      Background="{StaticResource BackgroundBrush}"
      PreviewKeyDown="Page_PreviewKeyDown">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{StaticResource BackgroundBrush}">

            <Border Margin="20"
            Padding="25"
            Background="{StaticResource DarkBrush}"
            CornerRadius="24">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,30">

                        <TextBlock Text="Edit Sensor"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource TitleBrush}"/>

                        <TextBlock Text="Update the configuration of this sensor."
                           FontSize="14"
                           Foreground="{StaticResource SubTitleBrush}"
                           Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- FORM -->
                    <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="18"
                    Padding="35">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- NAME -->
                            <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,12,18">
                                <TextBlock Text="Sensor name"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Height="48"
                                 Padding="12"/>
                            </StackPanel>

                            <!-- DEVICE -->
                            <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="12,0,0,18">
                                <TextBlock Text="Device identifier"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                                <TextBox Text="{Binding DeviceIdentifier, UpdateSourceTrigger=PropertyChanged}"
                                 Height="48"
                                 Padding="12"/>
                            </StackPanel>

                            <!-- LOCATION -->
                            <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,12,18">
                                <TextBlock Text="Location"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                                <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                 Height="48"
                                 Padding="12"/>
                            </StackPanel>

                            <!-- CATEGORY -->
                            <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="12,0,0,18">
                                <TextBlock Text="Sensor category"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                                <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding Category, Mode=TwoWay}"
                                  Height="48"/>
                            </StackPanel>

                            <!-- PROTOCOL -->
                            <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,12,18">
                                <TextBlock Text="Communication protocol"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                                <ComboBox ItemsSource="{Binding Protocols}"
                                  SelectedItem="{Binding Protocol, Mode=TwoWay}"
                                  Height="48"/>
                            </StackPanel>

                            <!-- IP -->
                            <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Margin="12,0,0,18">
                                <TextBlock Text="IP address"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                                <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Height="48"
                                 Padding="12"/>
                            </StackPanel>

                            <!-- PORT -->
                            <StackPanel Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,0,12,18">
                                <TextBlock Text="Port"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 Height="48"
                                 Padding="12"/>
                            </StackPanel>

                            <!-- CONNECTION SETTINGS -->
                            <StackPanel Grid.Row="3"
                                Grid.Column="1"
                                Margin="12,0,0,18">

                                <TextBlock Text="Connection settings"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                                <CheckBox Content="Simulation sensor"
                                  IsChecked="{Binding IsSimulation, Mode=TwoWay}"
                                  Margin="0,0,0,12"/>

                                <CheckBox Content="Enable sensor connection"
                                  IsChecked="{Binding IsConnectionEnabled, Mode=TwoWay}"/>
                            </StackPanel>

                            <!-- DESCRIPTION -->
                            <StackPanel Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,18">
                                <TextBlock Text="Description"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="90"
                                 Padding="12"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <!-- ACTIVE -->
                            <StackPanel Grid.Row="5"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,18">

                                <CheckBox Content="Sensor is active"
                                  IsChecked="{Binding IsActive, Mode=TwoWay}"
                                  FontSize="14"/>
                            </StackPanel>

                            <!-- LOG FILES -->
                            <StackPanel Grid.Row="6"
                                Grid.ColumnSpan="2"
                                Margin="0,5,0,20">

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Sensor Log Files"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="#30343A"/>

                                        <TextBlock Text="Log files uploaded for this sensor."
                                           FontSize="12"
                                           Foreground="{StaticResource SubTitleBrush}"
                                           Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                    Content="Upload Log File"
                                    Height="42"
                                    Padding="20,0"
                                    Command="{Binding AddLogFileCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>

                                <Border Background="#FAFBFC"
                                BorderBrush="#D8DDE2"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">

                                    <ItemsControl ItemsSource="{Binding LogFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="White"
                                                BorderBrush="#E2E6EA"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="12"
                                                Margin="0,0,0,8">

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"/>

                                                        <TextBlock Text="{Binding CreatedAt, StringFormat='Uploaded: {0:g}'}"
                                                           FontSize="11"
                                                           Foreground="#777777"
                                                           Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>

                            <!-- ERROR -->
                            <TextBlock Grid.Row="7"
                               Grid.ColumnSpan="2"
                               Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,5,0,15"/>

                            <!-- SAVE -->
                            <Button Grid.Row="8"
                            Grid.ColumnSpan="2"
                            Content="Save Changes"
                            Command="{Binding SaveSensorCommand}"
                            Style="{StaticResource BaseButtonStyle}"/>

                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
