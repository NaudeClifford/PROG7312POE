<Page x:Class="SmartX.WPF.Views.Pages.Sensor.SensorEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Edit Sensor"
      Background="{StaticResource BackgroundBrush}"
      PreviewKeyDown="Page_PreviewKeyDown">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto">

        <Grid Margin="60">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="0"
                Margin="0,0,0,30">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    HorizontalAlignment="Center">

                    <TextBlock
                        Text="Edit Sensor"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="{StaticResource TitleBrush}"/>

                    <TextBlock
                        Text="Update the configuration of this sensor."
                        FontSize="14"
                        Foreground="{StaticResource SubTitleBrush}"
                        Margin="0,8,0,0"/>

                </StackPanel>

            </Grid>


            <!-- ================================================= -->
            <!-- FORM -->
            <!-- ================================================= -->

            <Border
                Grid.Row="1"
                Background="White"
                CornerRadius="18"
                Padding="35">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <!-- ========================================= -->
                    <!-- SENSOR NAME -->
                    <!-- ========================================= -->

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,18">

                        <TextBlock
                            Text="Sensor name"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding Name,
                                               UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- ========================================= -->
                    <!-- DEVICE IDENTIFIER -->
                    <!-- ========================================= -->

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="12,0,0,18">

                        <TextBlock
                            Text="Device identifier"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding DeviceIdentifier,
                                               UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- ========================================= -->
                    <!-- LOCATION -->
                    <!-- ========================================= -->

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,12,18">

                        <TextBlock
                            Text="Location"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding Location,
                                               UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- ========================================= -->
                    <!-- CATEGORY -->
                    <!-- ========================================= -->

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,0,0,18">

                        <TextBlock
                            Text="Sensor category"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <ComboBox
                                ItemsSource="{Binding Categories}"
                                SelectedItem="{Binding Category, Mode=TwoWay}"
                                Margin="6,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>


                    <!-- ========================================= -->
                    <!-- DESCRIPTION -->
                    <!-- ========================================= -->

                    <StackPanel
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,18">

                        <TextBlock
                            Text="Description"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            MinHeight="90"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding Description,
                                               UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,10"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"/>

                        </Border>

                    </StackPanel>


                    <!-- ========================================= -->
                    <!-- ACTIVE -->
                    <!-- ========================================= -->

                    <StackPanel
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Margin="0,0,0,18">

                        <CheckBox
                            Content="Sensor is active"
                            IsChecked="{Binding IsActive}"
                            FontSize="14"
                            VerticalAlignment="Center"/>

                    </StackPanel>


                    <!-- ========================================= -->
                    <!-- SENSOR LOG FILES -->
                    <!-- ========================================= -->

                    <StackPanel
    Grid.Row="4"
    Grid.ColumnSpan="2"
    Margin="0,5,0,20">

                        <Grid Margin="0,0,0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel
            Grid.Column="0">

                                <TextBlock
                Text="Sensor Log Files"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="#30343A"/>

                                <TextBlock
                Text="Log files uploaded for this sensor."
                FontSize="12"
                Foreground="{StaticResource SubTitleBrush}"
                Margin="0,4,0,0"/>

                            </StackPanel>

                            <Button
            Grid.Column="1"
            Content="Upload Log File"
            Height="42"
            Padding="20,0"
            Command="{Binding AddLogFileCommand}"
            FontSize="13"
            FontWeight="SemiBold"
            Style="{StaticResource SecondaryButtonStyle}"/>

                        </Grid>

                        <Border
        Background="#FAFBFC"
        BorderBrush="#D8DDE2"
        BorderThickness="1"
        CornerRadius="8"
        Padding="12">

                            <ItemsControl
            ItemsSource="{Binding LogFiles}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                        Background="White"
                        BorderBrush="#E2E6EA"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,8">

                                            <StackPanel>

                                                <TextBlock
                                Text="{Binding FileName}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#30343A"/>

                                                <TextBlock
                                Text="{Binding CreatedAt, StringFormat='Uploaded: {0:g}'}"
                                FontSize="11"
                                Foreground="#777777"
                                Margin="0,4,0,0"/>

                                            </StackPanel>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </Border>

                    </StackPanel>


                    <!-- ========================================= -->
                    <!-- ERROR -->
                    <!-- ========================================= -->

                    <TextBlock
                        Grid.Row="5"
                        Grid.ColumnSpan="2"
                        Text="{Binding ErrorMessage}"
                        Foreground="#C62828"
                        FontSize="13"
                        TextWrapping="Wrap"
                        Margin="0,5,0,15"/>


                    <!-- ========================================= -->
                    <!-- SAVE -->
                    <!-- ========================================= -->

                    <Button
                        Grid.Row="6"
                        Grid.ColumnSpan="2"
                        Content="Save Changes"
                        Height="50"
                        Command="{Binding SaveSensorCommand}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Style="{StaticResource BaseButtonStyle}"/>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>