<Page x:Class="SmartX.WPF.Views.Pages.Sensor.SensorsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Sensors"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ===================================================== -->
        <!-- HEADER -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
              Margin="0,0,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- PAGE TITLE -->

            <StackPanel Grid.Column="0">

                <TextBlock
                    Text="Sensors"
                    FontSize="32"
                    FontWeight="Bold"
                    Foreground="{StaticResource DarkBrush}"/>

                <TextBlock
                    Text="Manage connected sensors and view telemetry."
                    FontSize="14"
                    Foreground="#737A82"
                    Margin="0,6,0,0"/>

            </StackPanel>


            <!-- RIGHT SIDE -->

            <StackPanel
                Grid.Column="1"
                HorizontalAlignment="Right">


                <!-- CURRENT GATEWAY -->

                <Border
                    Background="#EAF2FF"
                    BorderBrush="#D5E3FA"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14,8"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,12">

                    <StackPanel
                        Orientation="Horizontal">

                        <TextBlock
                            Text="Gateway:"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#657080"
                            VerticalAlignment="Center"/>

                        <TextBlock
                            Text="{Binding CurrentGatewayName}"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{StaticResource DarkBrush}"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"/>

                    </StackPanel>

                </Border>


                <!-- ACTION BUTTONS -->

                <StackPanel
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                    <Button
                        Content="+ Add Sensor"
                        Command="{Binding AddSensorCommand}"
                        Padding="18,8"
                        Margin="0,0,10,0"
                        Style="{StaticResource BaseButtonStyle}"/>

                    <Button
                        Content="Add Log File"
                        Command="{Binding AddLogFileCommand}"
                        Padding="18,8"
                        Style="{StaticResource BaseButtonStyle}"/>

                </StackPanel>

            </StackPanel>

        </Grid>


        <!-- ===================================================== -->
        <!-- SENSOR LIST -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="1"
            Background="White"
            CornerRadius="15"
            Padding="25">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- LIST HEADER -->

                <Grid Grid.Row="0">

                    <TextBlock
                        Text="Connected Sensors"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource DarkBrush}"/>


                    <!-- EDIT / DELETE -->

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                        <Button
                            Content="Edit"
                            Command="{Binding EditSensorCommand}"
                            Padding="12,6"
                            Margin="0,0,8,0"/>

                        <Button
                            Content="Delete"
                            Command="{Binding DeleteSensorCommand}"
                            Padding="12,6"/>

                    </StackPanel>

                </Grid>


                <!-- DATAGRID -->

                <DataGrid
                    Grid.Row="1"
                    Margin="0,20,0,0"
                    AutoGenerateColumns="False"
                    SelectedItem="{Binding SelectedSensor, Mode=TwoWay}"
                    IsReadOnly="True"
                    HeadersVisibility="Column"
                    BorderThickness="0"
                    GridLinesVisibility="Horizontal"
                    ItemsSource="{Binding Sensors}">

                    <DataGrid.Columns>


                        <!-- SENSOR -->

                        <DataGridTextColumn
                            Header="Sensor"
                            Binding="{Binding Name}"
                            Width="2*"/>


                        <!-- TYPE -->

                        <DataGridTextColumn
                            Header="Type"
                            Binding="{Binding Category}"
                            Width="*"/>


                        <!-- LOCATION -->

                        <DataGridTextColumn
                            Header="Location"
                            Binding="{Binding Location}"
                            Width="1.5*"/>


                        <!-- DEVICE -->

                        <DataGridTextColumn
                            Header="Device"
                            Binding="{Binding DeviceIdentifier}"
                            Width="1.5*"/>


                        <!-- STATUS -->

                        <DataGridTextColumn
                            Header="Status"
                            Binding="{Binding IsActive}"
                            Width="*"/>


                        <!-- TELEMETRY -->

                        <DataGridTemplateColumn
                            Header="Telemetry"
                            Width="Auto">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Button
                                        Content="View"
                                        Command="{Binding DataContext.OpenTelemetryCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Padding="12,6"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Page>