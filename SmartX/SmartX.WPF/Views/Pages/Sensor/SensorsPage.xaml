<Page x:Class="SmartX.WPF.Views.Pages.Sensor.SensorsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Sensors"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="35">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <Grid Grid.Row="0">

            <StackPanel>

                <TextBlock Text="Sensors"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource DarkBrush}"/>

                <TextBlock Text="Monitor the current state of your connected sensors."
                           FontSize="14"
                           Foreground="#737A82"
                           Margin="0,6,0,0"/>

            </StackPanel>

            <Border HorizontalAlignment="Right"
                    Background="#EAF7EF"
                    CornerRadius="18"
                    Padding="15,8">

                <StackPanel Orientation="Horizontal">

                    <Ellipse Width="9"
                             Height="9"
                             Fill="#28A745"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"/>

                    <TextBlock Text="System Online"
                               Foreground="#218838"
                               FontWeight="SemiBold"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- SUMMARY CARDS -->

        <Grid Grid.Row="1"
              Margin="0,30,0,25">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <!-- Total Sensors -->
            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="20"
                    Background="White"
                    CornerRadius="15">

                <StackPanel>

                    <TextBlock Text="TOTAL SENSORS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#8A929A"/>

                    <TextBlock Text="{Binding TotalSensors}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{StaticResource DarkBrush}"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <!-- Online -->
            <Border Grid.Column="1"
                    Margin="12,0"
                    Padding="20"
                    Background="White"
                    CornerRadius="15">

                <StackPanel>

                    <TextBlock Text="ONLINE"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#8A929A"/>

                    <TextBlock Text="{Binding OnlineSensors}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#28A745"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <!-- Offline -->
            <Border Grid.Column="2"
                    Margin="12,0"
                    Padding="20"
                    Background="White"
                    CornerRadius="15">

                <StackPanel>

                    <TextBlock Text="OFFLINE"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#8A929A"/>

                    <TextBlock Text="{Binding OfflineSensors}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#DC3545"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <!-- Alerts -->
            <Border Grid.Column="3"
                    Margin="12,0,0,0"
                    Padding="20"
                    Background="White"
                    CornerRadius="15">

                <StackPanel>

                    <TextBlock Text="ACTIVE ALERTS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#8A929A"/>

                    <TextBlock Text="{Binding ActiveAlerts}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#E09F00"
                               Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- SENSOR LIST -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="15"
                Padding="25">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <Grid>

                    <TextBlock Text="Connected Sensors"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource DarkBrush}"/>

                    <Button Content="+ Add Sensor"
                            HorizontalAlignment="Right"
                            Padding="18,8"
                            Style="{StaticResource BaseButtonStyle}"/>

                </Grid>


                <DataGrid Grid.Row="1"
          x:Name="SensorsDataGrid"
          Margin="0,20,0,0"
          AutoGenerateColumns="False"
          SelectedItem="{Binding SelectedSensor, Mode=TwoWay}"
          IsReadOnly="True"
          HeadersVisibility="Column"
          BorderThickness="0"
          GridLinesVisibility="Horizontal"
          ItemsSource="{Binding Sensors}">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Sensor"
                        Binding="{Binding Name}"
                        Width="2*"/>

                        <DataGridTextColumn Header="Type"
                        Binding="{Binding Category}"
                        Width="*"/>

                        <DataGridTextColumn Header="Location"
                        Binding="{Binding Location}"
                        Width="1.5*"/>

                        <DataGridTextColumn Header="Device"
                        Binding="{Binding DeviceIdentifier}"
                        Width="1.5*"/>

                        <DataGridTextColumn Header="Status"
                        Binding="{Binding IsActive}"
                        Width="*"/>

                        <DataGridTemplateColumn Header="Actions"
                            Width="Auto">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Button Content="Telemetry"
                                            Command="{Binding DataContext.OpenTelemetryCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Padding="12,6"/>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Page>