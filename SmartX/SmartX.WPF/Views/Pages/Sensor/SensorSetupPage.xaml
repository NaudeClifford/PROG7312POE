<Page x:Class="SmartX.WPF.Views.Pages.Sensor.SensorSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Sensor Setup"
      Background="{StaticResource BackgroundBrush}"
      PreviewKeyDown="Page_PreviewKeyDown">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="20"
            Padding="25"
            Background="{StaticResource DarkBrush}"
            CornerRadius="24">

            <Grid Margin="10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                    <TextBlock Text="Sensor Setup"
                           Style="{StaticResource PageTitleStyle}"
                           Foreground="{StaticResource TitleBrush}"/>

                    <TextBlock Text="Add a sensor to the current gateway."
                           Style="{StaticResource SectionTitleStyle}"
                           Margin="0,8,0,0"/>
                </StackPanel>

                <!-- FORM -->
                <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="18"
                    Padding="35">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- NAME -->
                        <StackPanel Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,12,18">
                            <TextBlock Text="Sensor name"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Height="48"
                                 Padding="12"
                                 FontSize="14"/>
                        </StackPanel>

                        <!-- DEVICE IDENTIFIER -->
                        <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                Margin="12,0,0,18">
                            <TextBlock Text="Device identifier"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                            <TextBox Text="{Binding DeviceIdentifier, UpdateSourceTrigger=PropertyChanged}"
                                 Height="48"
                                 Padding="12"
                                 FontSize="14"/>
                        </StackPanel>

                        <!-- LOCATION -->
                        <StackPanel Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,0,12,18">
                            <TextBlock Text="Location"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                            <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}"
                                 Height="48"
                                 Padding="12"
                                 FontSize="14"/>
                        </StackPanel>

                        <!-- CATEGORY -->
                        <StackPanel Grid.Row="1"
                                Grid.Column="1"
                                Margin="12,0,0,18">
                            <TextBlock Text="Sensor category"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                            <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding Category, Mode=TwoWay}"
                                  Height="48"
                                  FontSize="14"/>
                        </StackPanel>

                        <!-- PROTOCOL -->
                        <StackPanel Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,0,12,18">
                            <TextBlock Text="Communication protocol"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                            <ComboBox ItemsSource="{Binding Protocols}"
                                  SelectedItem="{Binding SelectedProtocol, Mode=TwoWay}"
                                  Height="48"
                                  FontSize="14"/>
                        </StackPanel>

                        <!-- IP ADDRESS -->
                        <StackPanel Grid.Row="2"
                                Grid.Column="1"
                                Margin="12,0,0,18">
                            <TextBlock Text="IP address"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                            <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Height="48"
                                 Padding="12"
                                 FontSize="14"/>
                        </StackPanel>

                        <!-- PORT -->
                        <StackPanel Grid.Row="3"
                                Grid.Column="0"
                                Margin="0,0,12,18">
                            <TextBlock Text="Port"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                            <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                 Height="48"
                                 Padding="12"
                                 FontSize="14"/>
                        </StackPanel>

                        <!-- CONNECTION SETTINGS -->
                        <StackPanel Grid.Row="3"
                                Grid.Column="1"
                                Margin="12,0,0,18">

                            <TextBlock Text="Connection settings"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                            <CheckBox Content="Simulation sensor"
                                  IsChecked="{Binding IsSimulation, Mode=TwoWay}"
                                  Margin="0,0,0,12"
                                  FontSize="14"/>

                            <CheckBox Content="Enable sensor connection"
                                  IsChecked="{Binding IsConnectionEnabled, Mode=TwoWay}"
                                  FontSize="14"/>
                        </StackPanel>

                        <!-- DESCRIPTION -->
                        <StackPanel Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Margin="0,0,0,18">
                            <TextBlock Text="Description"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="90"
                                 Padding="12"
                                 FontSize="14"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- ERROR -->
                        <TextBlock Grid.Row="5"
                               Grid.ColumnSpan="2"
                               Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,5,0,15"/>

                        <!-- CREATE -->
                        <Button Grid.Row="6"
                            Grid.ColumnSpan="2"
                            Content="Create Sensor"
                            Command="{Binding SaveSensorCommand}"
                            Style="{StaticResource BaseButtonStyle}"/>

                    </Grid>
                </Border>
            </Grid>
        
        </Border>
        
    </ScrollViewer>
</Page>
