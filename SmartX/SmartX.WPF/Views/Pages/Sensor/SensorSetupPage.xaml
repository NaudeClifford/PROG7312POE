<Page x:Class="SmartX.WPF.Views.Pages.Sensor.SensorSetupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Sensor Setup"
      Background="{StaticResource BackgroundBrush}"
      PreviewKeyDown="Page_PreviewKeyDown">

    <ScrollViewer
        VerticalScrollBarVisibility="Auto">

        <Grid Margin="60">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <Grid
                Grid.Row="0"
                Margin="0,0,0,30">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0">

                    <TextBlock
                        Text="Sensor Setup"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="{StaticResource TitleBrush}"/>

                    <TextBlock
                        Text="Add a sensor to the current gateway."
                        FontSize="14"
                        Foreground="{StaticResource SubTitleBrush}"
                        Margin="0,8,0,0"/>

                </StackPanel>

            </Grid>

            <!-- ================================================= -->
            <!-- FORM -->
            <!-- ================================================= -->

            <Border
                Grid.Row="1"
                Background="White"
                CornerRadius="18"
                Padding="35">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ========================================= -->
                    <!-- SENSOR NAME -->
                    <!-- ========================================= -->

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,12,18">

                        <TextBlock
                            Text="Sensor name"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding Name,
                                               UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>

                    <!-- ========================================= -->
                    <!-- DEVICE IDENTIFIER -->
                    <!-- ========================================= -->

                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="12,0,0,18">

                        <TextBlock
                            Text="Device identifier"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding DeviceIdentifier,
                                               UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>

                    <!-- ========================================= -->
                    <!-- LOCATION -->
                    <!-- ========================================= -->

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,0,12,18">

                        <TextBlock
                            Text="Location"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding Location,
                                               UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>

                    <!-- ========================================= -->
                    <!-- CATEGORY -->
                    <!-- ========================================= -->

                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="12,0,0,18">

                        <TextBlock
                            Text="Sensor category"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            Height="48"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <ComboBox
                                ItemsSource="{Binding SensorCategories}"
                                SelectedItem="{Binding Category}"
                                Margin="6,0"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                VerticalContentAlignment="Center"/>

                        </Border>

                    </StackPanel>

                    <!-- ========================================= -->
                    <!-- DESCRIPTION -->
                    <!-- ========================================= -->

                    <StackPanel
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,0,0,18">

                        <TextBlock
                            Text="Description"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#30343A"
                            Margin="0,0,0,8"/>

                        <Border
                            MinHeight="90"
                            CornerRadius="8"
                            BorderBrush="#D8DDE2"
                            BorderThickness="1"
                            Background="#FAFBFC">

                            <TextBox
                                Text="{Binding Description,
                                               UpdateSourceTrigger=PropertyChanged}"
                                Margin="12,10"
                                BorderThickness="0"
                                Background="Transparent"
                                FontSize="14"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"/>

                        </Border>

                    </StackPanel>

                    <!-- ========================================= -->
                    <!-- ERROR -->
                    <!-- ========================================= -->

                    <TextBlock
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Text="{Binding ErrorMessage}"
                        Foreground="#C62828"
                        FontSize="13"
                        TextWrapping="Wrap"
                        Margin="0,5,0,15"/>

                    <!-- ========================================= -->
                    <!-- CREATE BUTTON -->
                    <!-- ========================================= -->

                    <Button
                        Grid.Row="4"
                        Grid.ColumnSpan="2"
                        Content="Create Sensor"
                        Height="50"
                        HorizontalAlignment="Right"
                        Padding="30,0"
                        Command="{Binding CreateSensorCommand}"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Style="{StaticResource BaseButtonStyle}"/>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</Page>