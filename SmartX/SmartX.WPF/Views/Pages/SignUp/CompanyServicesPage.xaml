<Page
    x:Class="SmartX.WPF.Views.Pages.SignUp.CompanyServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BackgroundBrush}">

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- HEADER -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Text="Configure company services"
                FontSize="28"
                Foreground="{StaticResource LightTextBrush}"
                HorizontalAlignment="Center"
                FontWeight="SemiBold"/>

            <TextBlock
                Margin="0,8,0,0"
                Text="Configure the services this company will use."
                HorizontalAlignment="Center"
                Foreground="{StaticResource LightTextBrush}"/>

        </StackPanel>


        <!-- ERROR -->

        <TextBlock
            Grid.Row="1"
            Margin="0,20,0,10"
            Text="{Binding ErrorMessage}"
            Foreground="Red"
            TextWrapping="Wrap"/>


        <!-- CONTENT -->

        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto">

            <StackPanel
                MaxWidth="700">


                <!-- API -->

                <GroupBox
                    Header="API"
                    Foreground="{StaticResource LightTextBrush}"
                    Margin="0,10">

                    <StackPanel Margin="15">

                        <CheckBox
                            Content="Use custom API"
                            Foreground="{StaticResource LightTextBrush}"
                            IsChecked="{Binding UseCustomApi}"/>


                        <StackPanel Margin="0,15,0,0">

                            <StackPanel.Style>

                                <Style
                                    TargetType="StackPanel">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding UseCustomApi}"
                                            Value="True">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </StackPanel.Style>


                            <TextBlock
                                Text="API Base URL"/>

                            <TextBox
                                Margin="0,5,0,0"
                                Text="{Binding ApiBaseUrl,
                                               UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock
                                Margin="0,5,0,0"
                                Text="Example: https://api.example.com"
                                Foreground="{StaticResource LightTextBrush}"/>

                        </StackPanel>

                    </StackPanel>

                </GroupBox>


                <!-- FIREBASE -->

                <GroupBox
                    Header="Firebase"
                    Foreground="{StaticResource LightTextBrush}"
                    Margin="0,10">

                    <StackPanel Margin="15">

                        <CheckBox
                            Content="Use custom Firebase"
                            Foreground="{StaticResource LightTextBrush}"
                            IsChecked="{Binding UseCustomFirebase}"/>


                        <StackPanel Margin="0,15,0,0">

                            <StackPanel.Style>

                                <Style
                                    TargetType="StackPanel">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding UseCustomFirebase}"
                                            Value="True">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </StackPanel.Style>


                            <TextBlock
                                Text="Firebase Project ID"/>

                            <TextBox
                                Margin="0,5,0,15"
                                Text="{Binding FirebaseProjectId,
                                               UpdateSourceTrigger=PropertyChanged}"/>


                            <TextBlock
                                Text="Firebase API Key"/>

                            <TextBox
                                Margin="0,5,0,0"
                                Text="{Binding FirebaseApiKey,
                                               UpdateSourceTrigger=PropertyChanged}"/>

                        </StackPanel>

                    </StackPanel>

                </GroupBox>


                <!-- STATUS -->

                <TextBlock
                    Margin="0,15,0,0"
                    Text="{Binding StatusMessage}"
                    Foreground="Green"
                    TextWrapping="Wrap"/>

            </StackPanel>

        </ScrollViewer>


        <!-- BUTTONS -->

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Content="Cancel"
                Width="100"
                Margin="0,0,10,0"
                Command="{Binding CancelCommand}"
                Style="{StaticResource BaseButtonStyle}"/>

            <Button
    Content="Test API"
    Width="120"
    Margin="0,0,10,0"
    Command="{Binding TestApiCommand}"
    Style="{StaticResource BaseButtonStyle}"/>

            <Button
                Content="Continue"
                Width="120"
                Command="{Binding ContinueCommand}"
                Style="{StaticResource BaseButtonStyle}"/>
      
        </StackPanel>

    </Grid>

</Page>
