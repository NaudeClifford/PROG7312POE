<Page x:Class="SmartX.WPF.Views.Pages.SignUp.SignUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Sign Up"
      Background="{StaticResource BackgroundBrush}"
          PreviewKeyDown="Page_PreviewKeyDown">

    <Page.Resources>

        <BooleanToVisibilityConverter
            x:Key="BooleanToVisibilityConverter"/>

    </Page.Resources>

    <Grid>

        <Border
            MaxWidth="560"
            Margin="40"
            Padding="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            CornerRadius="22">

            <StackPanel>

                <TextBlock
                    Text="{Binding StepTitle}"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="#20242A"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Text="Set up your SmartX company and administrator account."
                    FontSize="14"
                    Foreground="#707780"
                    TextAlignment="Center"
                    HorizontalAlignment="Center"
                    TextWrapping="Wrap"
                    Margin="0,8,0,25"/>


                <!-- STEP INDICATOR -->

                <Grid Margin="0,0,0,25">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Height="2"
                        Background="#2563EB"
                        VerticalAlignment="Center"/>

                    <Border
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        CornerRadius="17"
                        Background="#2563EB">

                        <TextBlock
                            Text="1"
                            Foreground="White"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>

                    </Border>

                    <Border
                        Grid.Column="2"
                        Height="2"
                        Background="#D8DDE2"
                        VerticalAlignment="Center"/>

                </Grid>


                <!-- COMPANY -->

                <StackPanel
                    Visibility="{Binding IsCompanyStep,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock
                        Text="Company name"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#30343A"
                        Margin="0,0,0,8"/>

                    <Border
                        Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                        <TextBox
                            Text="{Binding CompanyName,
                                   UpdateSourceTrigger=PropertyChanged}"
                            Margin="15,0"
                            BorderThickness="0"
                            Background="Transparent"
                            FontSize="14"
                            VerticalContentAlignment="Center"/>

                    </Border>


                    <TextBlock
                        Text="Description"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#30343A"
                        Margin="0,18,0,8"/>

                    <Border
                        MinHeight="90"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                        <TextBox
                            Text="{Binding CompanyDescription,
                                   UpdateSourceTrigger=PropertyChanged}"
                            Margin="15,10"
                            BorderThickness="0"
                            Background="Transparent"
                            FontSize="14"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"/>

                    </Border>

                </StackPanel>


                <!-- ADMINISTRATOR -->

                <StackPanel
                    Visibility="{Binding IsAdministratorStep,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock
                        Text="Your name"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#30343A"
                        Margin="0,0,0,8"/>

                    <Border
                        Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                        <TextBox
                            Text="{Binding DisplayName,
                                   UpdateSourceTrigger=PropertyChanged}"
                            Margin="15,0"
                            BorderThickness="0"
                            Background="Transparent"
                            FontSize="14"
                            VerticalContentAlignment="Center"/>

                    </Border>


                    <TextBlock
                        Text="Email address"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#30343A"
                        Margin="0,18,0,8"/>

                    <Border
                        Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                        <TextBox
                            Text="{Binding Email,
                                   UpdateSourceTrigger=PropertyChanged}"
                            Margin="15,0"
                            BorderThickness="0"
                            Background="Transparent"
                            FontSize="14"
                            VerticalContentAlignment="Center"/>

                    </Border>


                    <TextBlock
                        Text="Password"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#30343A"
                        Margin="0,18,0,8"/>

                    <Border
                        Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                        <PasswordBox
                            x:Name="PasswordBox"
                            PasswordChanged="PasswordBox_PasswordChanged"
                            Margin="15,0"
                            BorderThickness="0"
                            Background="Transparent"
                            FontSize="14"
                            VerticalContentAlignment="Center"/>

                    </Border>


                    <TextBlock
                        Text="Confirm password"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#30343A"
                        Margin="0,18,0,8"/>

                    <Border
                        Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                        <PasswordBox
                            x:Name="ConfirmPasswordBox"
                            PasswordChanged="ConfirmPasswordBox_PasswordChanged"
                            Margin="15,0"
                            BorderThickness="0"
                            Background="Transparent"
                            FontSize="14"
                            VerticalContentAlignment="Center"/>

                    </Border>

                </StackPanel>


                <!-- ERROR -->

                <Border
                    Background="#FFF1F1"
                    BorderBrush="#FFD0D0"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,15,0,0"
                    Visibility="{Binding HasError,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock
                        Text="{Binding ErrorMessage}"
                        Foreground="#C62828"
                        FontSize="13"
                        TextWrapping="Wrap"/>

                </Border>


                <!-- ACTION -->

                <Button
                    Content="{Binding ButtonText}"
                    Height="52"
                    Margin="0,22,0,0"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Command="{Binding ContinueCommand}"
                    Style="{StaticResource BaseButtonStyle}"/>

                <Button
                    Content="Cancel"
                    Height="42"
                    Margin="0,10,0,0"
                    FontSize="14"
                    Cursor="Hand"
                    Command="{Binding CancelCommand}"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>