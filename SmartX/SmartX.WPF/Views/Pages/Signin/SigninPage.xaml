<Page x:Class="SmartX.WPF.Views.Pages.SignUp.SignUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Create Account"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="60">

        <Border Width="520"
                Padding="45"
                CornerRadius="22"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- Header -->
                <TextBlock Text="Create your account"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#20242A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Join SmartX and start monitoring your sensors."
                           FontSize="14"
                           Foreground="#707780"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,8,0,30"/>


                <!-- Name -->
                <TextBlock Text="Full name"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#30343A"
                           Margin="0,0,0,8"/>

                <Border Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                    <TextBox x:Name="NameTextBox"
                             Margin="15,0"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>

                </Border>


                <!-- Email -->
                <TextBlock Text="Email address"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#30343A"
                           Margin="0,18,0,8"/>

                <Border Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                    <TextBox x:Name="EmailTextBox"
                             Margin="15,0"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>

                </Border>


                <!-- Password -->
                <TextBlock Text="Password"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#30343A"
                           Margin="0,18,0,8"/>

                <Border Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                    <PasswordBox x:Name="PasswordBox"
                                 Margin="15,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                </Border>


                <!-- Confirm password -->
                <TextBlock Text="Confirm password"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#30343A"
                           Margin="0,18,0,8"/>

                <Border Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 Margin="15,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                </Border>


                <!-- Error -->
                <Border x:Name="ErrorBorder"
                        Visibility="Collapsed"
                        Background="#FFF1F1"
                        BorderBrush="#FFD0D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,15,0,0">

                    <TextBlock x:Name="ErrorTextBlock"
                               Foreground="#C62828"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- Create account -->
                <Button x:Name="CreateAccountButton"
                        Content="Create Account"
                        Height="52"
                        Margin="0,22,0,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="CreateAccountButton_Click"
                        Style="{StaticResource BaseButtonStyle}"/>


                <!-- Login link -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,25,0,0">

                    <TextBlock Text="Already have an account?"
                               Foreground="#707780"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                    <Button x:Name="LoginButton"
                            Content="Login"
                            Margin="7,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#3F6FD9"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Padding="0"
                            Click="LoginButton_Click"/>

                </StackPanel>


                <TextBlock Text="Your account will be securely managed by Firebase."
                           HorizontalAlignment="Center"
                           Foreground="#9AA1A8"
                           FontSize="11"
                           Margin="0,22,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>