<Page x:Class="SmartX.WPF.Views.Pages.Signin.SigninPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Sign In"
      Background="{StaticResource BackgroundBrush}"
          PreviewKeyDown="Page_PreviewKeyDown">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Page.Resources>

    <Grid Margin="60">
        <Grid.RowDefinitions>
            <RowDefinition Height="11*"/>
            <RowDefinition Height="50*"/>
        </Grid.RowDefinitions>

        <Border Width="520"
                Padding="45"
                CornerRadius="22"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" Grid.RowSpan="2">

            <StackPanel>

                <TextBlock Text="Sign in to SmartX"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#20242A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Access your SmartX sensor monitoring platform."
                           FontSize="14"
                           Foreground="#707780"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,8,0,30"/>

                <TextBlock Text="Email address"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#30343A"
                           Margin="0,0,0,8"/>

                <Border Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="15,0"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>

                </Border>

                <TextBlock Text="Password"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#30343A"
                           Margin="0,18,0,8"/>

                <Border Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                    <PasswordBox x:Name="PasswordBox"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Margin="15,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                </Border>

                <Border Background="#FFF1F1"
                        BorderBrush="#FFD0D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,15,0,0"
                        Visibility="{Binding HasError,
                                     Converter={StaticResource BooleanToVisibilityConverter}}">

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#C62828"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                </Border>

                <Button Content="{Binding SignInButtonText}"
                        Height="52"
                        Margin="0,22,0,0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Command="{Binding SignInCommand}"
                        Style="{StaticResource BaseButtonStyle}"/>

                <CheckBox
    Content="Remember me"
    IsChecked="{Binding RememberMe}"
    Margin="0,10,0,10"/>
            </StackPanel>

        </Border>

    </Grid>

</Page>