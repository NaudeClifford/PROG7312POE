<Page x:Class="SmartX.WPF.Views.Pages.Login.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Login"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="60">

        <Border Width="480"
                Padding="45"
                CornerRadius="22"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <!-- Header -->
                <TextBlock Text="Welcome back"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#20242A"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Login to your SmartX account"
                           FontSize="14"
                           Foreground="#707780"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,35"/>


                <!-- Email -->
                <TextBlock Text="Email address"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#30343A"
                           Margin="0,0,0,8"/>

                <Border Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                    <TextBox x:Name="EmailTextBox"
                             Margin="15,0"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>

                </Border>


                <!-- Password -->
                <TextBlock Text="Password"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#30343A"
                           Margin="0,22,0,8"/>

                <Border Height="50"
                        CornerRadius="8"
                        BorderBrush="#D8DDE2"
                        BorderThickness="1"
                        Background="#FAFBFC">

                    <PasswordBox x:Name="PasswordBox"
                                 Margin="15,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 VerticalContentAlignment="Center"/>

                </Border>


                <!-- Options -->
                <Grid Margin="0,15,0,25">

                    <CheckBox x:Name="RememberMeCheckBox"
                              Content="Remember me"
                              Foreground="#606870"
                              FontSize="13"/>

                    <Button x:Name="ForgotPasswordButton"
                            Content="Forgot password?"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#3F6FD9"
                            Cursor="Hand"
                            Padding="0"/>

                </Grid>


                <!-- Login -->
                <Button x:Name="LoginButton"
                        Content="Login"
                        Height="52"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="LoginButton_Click"
                        Style="{StaticResource BaseButtonStyle}"/>


                <!-- Error -->
                <Border x:Name="ErrorBorder"
                        Visibility="Collapsed"
                        Background="#FFF1F1"
                        BorderBrush="#FFD0D0"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,15,0,0">

                    <TextBlock x:Name="ErrorTextBlock"
                               Foreground="#C62828"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- Create account -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,28,0,0">

                    <TextBlock Text="Don't have an account?"
                               Foreground="#707780"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                    <Button x:Name="CreateAccountButton"
                            Content="Create account"
                            Margin="7,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#3F6FD9"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Padding="0"
                            Click="CreateAccountButton_Click"/>

                </StackPanel>


                <TextBlock Text="Securely authenticated by Firebase"
                           HorizontalAlignment="Center"
                           Foreground="#9AA1A8"
                           FontSize="11"
                           Margin="0,25,0,0"/>

            </StackPanel>

        </Border>

    </Grid>

</Page>