<Page x:Class="SmartX.WPF.Views.Pages.Mesh.NetworkTopologyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Background="{StaticResource MeshBackground}"
      Title="Network Topology">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">

            <!-- HEADER -->

            <Border Background="#172554"
                    CornerRadius="16"
                    Padding="25"
                    Margin="0,0,0,18">

                <StackPanel>
                    <TextBlock Text="SMARTX NETWORK INTELLIGENCE"
                               Foreground="#38BDF8"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <TextBlock Text="Network Topology"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,8"/>

                    <TextBlock Text="Visualize mesh nodes, network connections and infrastructure health."
                               Foreground="#CBD5E1"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- GATEWAY -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                    <TextBlock Text="Gateway Configuration"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <TextBox Text="{Binding GatewayId,
                                     UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MeshInput}"
                             MaxWidth="550"
                             HorizontalAlignment="Left"/>

                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Load Topology"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding LoadTopologyCommand}"/>

                        <Button Content="Discover Nodes"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding DiscoverCommand}"/>

                        <Button Content="Synchronize"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding SynchronizeCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- STATUS -->

            <Border Background="#DBEAFE"
                    CornerRadius="10"
                    Padding="13"
                    Margin="5">

                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#1D4ED8"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#DC2626"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- KPI -->

            <UniformGrid Columns="4">

                <Border Style="{StaticResource MeshCard}">
                    <StackPanel>
                        <TextBlock Text="REGISTERED NODES"
                                   Foreground="#64748B"/>

                        <TextBlock Text="{Binding TotalNodes}"
                                   Style="{StaticResource MeshStatValue}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MeshCard}">
                    <StackPanel>
                        <TextBlock Text="TOTAL CONNECTIONS"
                                   Foreground="#64748B"/>

                        <TextBlock Text="{Binding TotalLinks}"
                                   Style="{StaticResource MeshStatValue}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MeshCard}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE CONNECTIONS"
                                   Foreground="#64748B"/>

                        <TextBlock Text="{Binding ActiveLinks}"
                                   Style="{StaticResource MeshStatValue}"
                                   Foreground="#16A34A"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MeshCard}">
                    <StackPanel>
                        <TextBlock Text="UNAVAILABLE LINKS"
                                   Foreground="#64748B"/>

                        <TextBlock Text="{Binding UnavailableLinks}"
                                   Style="{StaticResource MeshStatValue}"
                                   Foreground="#DC2626"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- GRAPHICAL TOPOLOGY -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>

                    <TextBlock Text="Network Connection Analytics"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <lvc:CartesianChart
                        Series="{Binding TopologyLinkSeries}"
                        XAxes="{Binding TopologyXAxis}"
                        YAxes="{Binding TopologyYAxis}"
                        Height="260"/>

                    <TextBlock Text="Connection distribution"
                               Foreground="#64748B"
                               FontSize="12"
                               Margin="0,8"/>
                </StackPanel>
            </Border>

            <!-- NODE OVERVIEW -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>

                    <TextBlock Text="Registered Mesh Nodes"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <DataGrid ItemsSource="{Binding Nodes}"
                              SelectedItem="{Binding SelectedNode}"
                              MinHeight="180"
                              MaxHeight="350"/>
                </StackPanel>
            </Border>

            <!-- SELECTED NODE -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>

                    <TextBlock Text="Selected Node Details"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <TextBlock Text="{Binding SelectedNode.Id,
                                        TargetNullValue=No node selected}"
                               Foreground="#2563EB"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding SelectedNode.Status,
                                        TargetNullValue=Select a node}"
                               Foreground="#64748B"
                               Margin="0,8"/>
                </StackPanel>
            </Border>

            <!-- CONNECTIONS -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>

                    <TextBlock Text="Mesh Connections"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <DataGrid ItemsSource="{Binding Links}"
                              SelectedItem="{Binding SelectedLink}"
                              MinHeight="180"
                              MaxHeight="350"/>
                </StackPanel>
            </Border>

            <!-- SELECTED LINK -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>

                    <TextBlock Text="Selected Connection Details"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <TextBlock Text="{Binding SelectedLink.Id,
                                        TargetNullValue=No connection selected}"
                               Foreground="#2563EB"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
