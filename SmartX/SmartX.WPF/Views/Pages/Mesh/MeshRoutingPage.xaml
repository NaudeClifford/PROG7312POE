<Page x:Class="SmartX.WPF.Views.Pages.Mesh.MeshRoutingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Background="{StaticResource MeshBackground}"
      Title="Mesh Routing Analytics">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="25">

            <!-- HEADER -->

            <Border Background="#172554"
                    CornerRadius="16"
                    Padding="25"
                    Margin="0,0,0,18">

                <StackPanel>
                    <TextBlock Text="SMARTX NETWORK INTELLIGENCE"
                               Foreground="#38BDF8"
                               FontSize="11"
                               FontWeight="Bold"/>

                    <TextBlock Text="Mesh Routing Analytics"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold"
                               Margin="0,8"/>

                    <TextBlock Text="Explore network paths, graph traversal and optimization algorithms."
                               Foreground="#CBD5E1"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- GATEWAY -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                    <TextBlock Text="Network Configuration"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <TextBlock Text="Gateway ID"
                               Foreground="#64748B"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding GatewayId,
                                     UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MeshInput}"
                             MaxWidth="550"
                             HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ROUTE INPUT -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                    <TextBlock Text="Route Configuration"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Source Node ID"
                                       Foreground="#64748B"/>

                            <TextBox Text="{Binding SourceNodeId,
                                            UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MeshInput}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="10,0,0,0">
                            <TextBlock Text="Destination Node ID"
                                       Foreground="#64748B"/>

                            <TextBox Text="{Binding DestinationNodeId,
                                            UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MeshInput}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Routing Algorithms"
                               Style="{StaticResource MeshSectionTitle}"
                               Margin="0,20,0,5"/>

                    <WrapPanel>
                        <Button Content="Shortest Path"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding ShortestPathCommand}"/>

                        <Button Content="BFS Route"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding FindBfsRouteCommand}"/>

                        <Button Content="DFS Route"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding FindDfsRouteCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- TRAVERSAL -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                    <TextBlock Text="Graph Traversal"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <TextBlock Text="Starting Node ID"
                               Foreground="#64748B"/>

                    <TextBox Text="{Binding StartNodeId,
                                    UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MeshInput}"
                             MaxWidth="550"
                             HorizontalAlignment="Left"/>

                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="Breadth First Search"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding BreadthFirstSearchCommand}"/>

                        <Button Content="Depth First Search"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding DepthFirstSearchCommand}"/>

                        <Button Content="Minimum Spanning Tree"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding SpanningTreeCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- STATUS -->

            <Border Background="#DBEAFE"
                    CornerRadius="10"
                    Padding="14"
                    Margin="5">

                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#1D4ED8"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#DC2626"
                               TextWrapping="Wrap"
                               Margin="0,5"/>

                    <TextBlock Text="{Binding ResultMessage}"
                               Foreground="#334155"
                               TextWrapping="Wrap"
                               Margin="0,5"/>
                </StackPanel>
            </Border>

            <!-- ROUTE ANALYTICS -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                    <TextBlock Text="Route Visualization"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <lvc:CartesianChart
                        Series="{Binding RouteSeries}"
                        XAxes="{Binding RoutingXAxis}"
                        YAxes="{Binding RoutingYAxis}"
                        Height="260"/>

                    <TextBlock Text="Node sequence along the calculated route"
                               Foreground="#64748B"
                               FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ROUTE RESULTS -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                    <TextBlock Text="Route Details"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <UniformGrid Columns="3">

                        <StackPanel Margin="5">
                            <TextBlock Text="HOPS"
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding RoutingResult.HopCount,
                                                 TargetNullValue=0}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="TOTAL COST"
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding RoutingResult.TotalCost,
                                                 StringFormat={}{0:F2},
                                                 TargetNullValue=0}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#172554"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="LATENCY"
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding RoutingResult.TotalLatency,
                                                 StringFormat={}{0:F2} ms,
                                                 TargetNullValue=0}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#16A34A"/>
                        </StackPanel>

                    </UniformGrid>

                    <TextBlock Text="Route Node Sequence"
                               Style="{StaticResource MeshSectionTitle}"
                               Margin="0,20,0,10"/>

                    <ItemsControl ItemsSource="{Binding RouteNodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#DBEAFE"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="4">

                                    <TextBlock Text="{Binding}"
                                               Foreground="#1D4ED8"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- TRAVERSAL CHART -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                    <TextBlock Text="Traversal Analytics"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <lvc:CartesianChart
                        Series="{Binding TraversalSeries}"
                        Height="260"/>

                    <TextBlock Text="Order in which nodes were visited"
                               Foreground="#64748B"
                               FontSize="12"/>

                    <TextBlock Text="Visited Node Sequence"
                               Style="{StaticResource MeshSectionTitle}"
                               Margin="0,20,0,10"/>

                    <ItemsControl ItemsSource="{Binding VisitedNodes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#DCFCE7"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="4">

                                    <TextBlock Text="{Binding}"
                                               Foreground="#15803D"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- SPANNING TREE -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                    <TextBlock Text="Minimum Spanning Tree Analytics"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <UniformGrid Columns="3">

                        <StackPanel Margin="5">
                            <TextBlock Text="CONNECTIONS"
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding SpanningTree.TotalConnections,
                                                 TargetNullValue=0}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#172554"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="TOTAL COST"
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding SpanningTree.TotalCost,
                                                 StringFormat={}{0:F2},
                                                 TargetNullValue=0}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#2563EB"/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="ENERGY COST"
                                       Foreground="#64748B"/>

                            <TextBlock Text="{Binding SpanningTree.TotalEnergyCost,
                                                 StringFormat={}{0:F2},
                                                 TargetNullValue=0}"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#16A34A"/>
                        </StackPanel>

                    </UniformGrid>

                    <lvc:CartesianChart
                        Series="{Binding SpanningTreeSeries}"
                        Height="250"
                        Margin="0,15,0,0"/>

                    <TextBlock Text="Spanning Tree Connections"
                               Style="{StaticResource MeshSectionTitle}"
                               Margin="0,20,0,10"/>

                    <DataGrid ItemsSource="{Binding SpanningTree.Connections}"
                              MinHeight="120"
                              MaxHeight="300"/>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
