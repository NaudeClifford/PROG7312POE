<Page x:Class="SmartX.WPF.Views.Pages.Mesh.MeshDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#F4F6FA"
      Title="Mesh Dashboard">

    <Page.Resources>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Border Margin="20"
            Padding="25"
            Background="{StaticResource DarkBrush}"
            CornerRadius="24">

            <Grid Margin="10">

                <StackPanel Margin="25">

                    <!-- HEADER -->
                    <Border Background="#172554" BorderBrush="White" BorderThickness="2"
                    CornerRadius="12"
                    Padding="25"
                    Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Mesh Network Dashboard" Style="{StaticResource PageTitleStyle}"/>

                    <TextBlock Text="Monitor, discover and manage your mesh network." Style="{StaticResource SectionTitle}" Foreground="White"/>
                </StackPanel>
        </Border>
        <!-- GATEWAY SELECTION -->

                    <Border Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,0,15">

                        <StackPanel>

                            <TextBlock Text="Gateway Configuration" Style="{StaticResource SectionTitle}"/>

                            <TextBlock Text="Gateway ID" Style="{StaticResource BodyTextStyleBlack}"/>

                            <TextBox Text="{Binding GatewayId, UpdateSourceTrigger=PropertyChanged}"
                             Padding="9"
                             Margin="0,5,0,12"/>

                            <WrapPanel>

                                <Button Content="Load Dashboard"
                                Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding LoadDashboardCommand}"/>

                                <Button Content="Discover Nodes"
                                Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding DiscoverCommand}"/>

                                <Button Content="Synchronize"
                                Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding SynchronizeCommand}"/>

                                <Button Content="Refresh Monitoring"
                                Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding RefreshMonitoringCommand}"/>

                                <Button Content="Evaluate Links"
                                Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding EvaluateLinksCommand}"/>

                            </WrapPanel>

                        </StackPanel>

                    </Border>

                    <!-- STATUS -->

                    <Border Background="#EFF6FF"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0,0,0,15">

                        <StackPanel>

                            <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#1D4ED8"
                               FontWeight="SemiBold"/>

                            <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#DC2626"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"/>

                            <TextBlock Text="Loading..."
                               Foreground="#2563EB"
                               FontWeight="SemiBold"
                               Margin="0,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                        </StackPanel>

                    </Border>

                    <!-- NETWORK HEALTH -->

                    <TextBlock Text="Network Health"
                       Style="{StaticResource SectionTitle}" Foreground="White"/>

                    <UniformGrid Columns="4" Margin="0,0,0,15">

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Total Nodes"  Style="{StaticResource BodyTextStyleBlack }"/>
                                <TextBlock Text="{Binding TotalNodes}"
                                   FontSize="27"
                                   FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Online Nodes" Style="{StaticResource BodyTextStyleBlack }"/>
                                <TextBlock Text="{Binding OnlineNodes}"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Offline Nodes" Style="{StaticResource BodyTextStyleBlack }"/>
                                <TextBlock Text="{Binding OfflineNodes}"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#DC2626"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Degraded Nodes" Style="{StaticResource BodyTextStyleBlack }"/>
                                <TextBlock Text="{Binding DegradedNodes}"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#D97706"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <UniformGrid Columns="3" Margin="0,0,0,20">

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Total Links" Style="{StaticResource BodyTextStyleBlack }"/>
                                <TextBlock Text="{Binding TotalLinks}"
                                   FontSize="25"
                                   FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Available Links" Style="{StaticResource BodyTextStyleBlack }"/>
                                <TextBlock Text="{Binding AvailableLinks}"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#16A34A"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="Network Availability" Style="{StaticResource BodyTextStyleBlack }"/>
                                    
                                <TextBlock Text="{Binding NetworkAvailability, StringFormat={}{0:F2}%}"
                                   FontSize="25"
                                   FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- HEALTH STATUS -->

                    <Border Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,0,20">

                        <StackPanel>
                            <TextBlock Text="Overall Network Status" Style="{StaticResource BodyTextStyleBlack}"/>

                            <TextBlock Text="{Binding HealthStatus}"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,5,0,0"/>
                        </StackPanel>

                    </Border>

                    <!-- NODES -->

                    <TextBlock Text="Mesh Nodes"
                       Style="{StaticResource SectionTitle}" Foreground="White"/>

                    <DataGrid ItemsSource="{Binding Nodes}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="White"
                      Margin="0,0,0,20"
                      MinHeight="150"/>

                    <!-- LINKS -->

                    <TextBlock Text="Mesh Links"
                       Style="{StaticResource SectionTitle}" Foreground="White"/>

                    <DataGrid ItemsSource="{Binding Links}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="White"
                      Margin="0,0,0,20"
                      MinHeight="150"/>

                    <!-- LOGS -->

                    <TextBlock Text="Gateway Logs"
                       Style="{StaticResource SectionTitle}" Foreground="White"/>



                    <DataGrid ItemsSource="{Binding Logs}"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="White"
                      MinHeight="180"
                      Margin="0,0,0,20"/>
                    <Button Content="Reload Logs"
                    Style="{StaticResource SecondColourButtonStyle}"
                    HorizontalAlignment="Left"
                    Command="{Binding LoadLogsCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </ScrollViewer>

</Page>
