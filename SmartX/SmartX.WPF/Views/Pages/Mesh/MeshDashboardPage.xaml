<Page x:Class="SmartX.WPF.Views.Pages.Mesh.MeshDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
      Background="{StaticResource MeshBackground}"
      Title="Mesh Intelligence Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">

            <!-- HEADER -->

            <Border Background="#172554"
                    CornerRadius="16"
                    Padding="25"
                    Margin="0,0,0,18">

                <Grid>
                    <StackPanel>
                        <TextBlock Text="SMARTX NETWORK INTELLIGENCE"
                                   Foreground="#38BDF8"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Mesh Dashboard"
                                   Foreground="White"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Margin="0,8"/>

                        <TextBlock Text="Real-time network health, connectivity and routing analytics."
                                   Foreground="#CBD5E1"
                                   FontSize="13"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONFIGURATION -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                    <TextBlock Text="Gateway Configuration"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <TextBox Text="{Binding GatewayId, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MeshInput}"
                             MaxWidth="550"
                             HorizontalAlignment="Left"/>

                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="Load Dashboard"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding LoadDashboardCommand}"/>

                        <Button Content="Discover"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding DiscoverCommand}"/>

                        <Button Content="Synchronize"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding SynchronizeCommand}"/>

                        <Button Content="Refresh Monitoring"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding RefreshMonitoringCommand}"/>

                        <Button Content="Evaluate Links"
                                Style="{StaticResource MeshButton}"
                                Command="{Binding EvaluateLinksCommand}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- STATUS -->

            <Border Background="#DBEAFE"
                    CornerRadius="10"
                    Padding="14"
                    Margin="5">

                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="#1D4ED8"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#DC2626"
                               TextWrapping="Wrap"
                               Margin="0,5"/>

                    <ProgressBar Height="5"
             IsIndeterminate="True"
             Visibility="Visible"
             Value="50">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <!-- KPI CARDS -->

            <UniformGrid Columns="4">

                <Border Style="{StaticResource MeshCard}">
                    <StackPanel>
                        <TextBlock Text="TOTAL NODES"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding TotalNodes}"
                                   Style="{StaticResource MeshStatValue}"/>

                        <TextBlock Text="Registered devices"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MeshCard}">
                    <StackPanel>
                        <TextBlock Text="ONLINE NODES"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding OnlineNodes}"
                                   Style="{StaticResource MeshStatValue}"
                                   Foreground="#16A34A"/>

                        <TextBlock Text="Operational devices"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MeshCard}">
                    <StackPanel>
                        <TextBlock Text="ACTIVE LINKS"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding AvailableLinks}"
                                   Style="{StaticResource MeshStatValue}"
                                   Foreground="#2563EB"/>

                        <TextBlock Text="Available connections"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MeshCard}">
                    <StackPanel>
                        <TextBlock Text="AVAILABILITY"
                                   Foreground="#64748B"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding NetworkAvailability,
                                         StringFormat={}{0:F2}%}"
                                   Style="{StaticResource MeshStatValue}"
                                   Foreground="#16A34A"/>

                        <TextBlock Text="Network uptime indicator"
                                   Foreground="#64748B"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- CHART ROW -->

            <UniformGrid Columns="2">

                <!-- NODE HEALTH -->

                <Border Style="{StaticResource MeshCard}">
                    <StackPanel>
                        <TextBlock Text="Node Health Distribution"
                                   Style="{StaticResource MeshSectionTitle}"/>

                        <lvc:PieChart Series="{Binding NodeHealthSeries}"
                                      Height="260"
                                      LegendPosition="Bottom"/>
                    </StackPanel>
                </Border>

                <!-- LINKS -->

                <Border Style="{StaticResource MeshCard}">
                    <StackPanel>
                        <TextBlock Text="Connection Availability"
                                   Style="{StaticResource MeshSectionTitle}"/>

                        <lvc:CartesianChart Series="{Binding LinkHealthSeries}"
                                            XAxes="{Binding DashboardXAxis}"
                                            YAxes="{Binding DashboardYAxis}"
                                            Height="260"/>
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ROUTING ANALYTICS -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>

                    <TextBlock Text="Routing Performance"
                   Style="{StaticResource MeshSectionTitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <lvc:CartesianChart Grid.Column="0"
                                Series="{Binding RoutingSeries}"
                                XAxes="{Binding DashboardXAxis}"
                                YAxes="{Binding DashboardYAxis}"
                                Height="250"/>

                        <StackPanel Grid.Column="1"
                        Margin="20,10">

                            <TextBlock Text="Average Latency"
                           Foreground="#64748B"/>

                            <TextBlock Text="{Binding AverageLatency,
                                     StringFormat={}{0:F2} ms}"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#2563EB"/>

                            <TextBlock Text="Total Routes"
                           Foreground="#64748B"
                           Margin="0,15,0,0"/>

                            <TextBlock Text="{Binding TotalRoutes}"
                           FontSize="25"
                           FontWeight="Bold"/>

                            <TextBlock Text="Failed Routes"
                           Foreground="#64748B"
                           Margin="0,15,0,0"/>

                            <TextBlock Text="{Binding FailedRoutes}"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#DC2626"/>

                        </StackPanel>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- WARNINGS -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                    <TextBlock Text="Network Warnings"
                               Style="{StaticResource MeshSectionTitle}"/>

                    <ItemsControl ItemsSource="{Binding Warnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFF7ED"
                                        CornerRadius="7"
                                        Padding="12"
                                        Margin="0,3">
                                    <TextBlock Text="{Binding}"
                                               Foreground="#C2410C"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- NODES -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                <TextBlock Text="Mesh Nodes"
                           Style="{StaticResource MeshSectionTitle}"/>

                <DataGrid ItemsSource="{Binding Nodes}"
                          MinHeight="160"
                          MaxHeight="320"/>
                          </StackPanel>
            </Border>

            <!-- LINKS -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                <TextBlock Text="Mesh Connections"
                           Style="{StaticResource MeshSectionTitle}"/>

                <DataGrid ItemsSource="{Binding Links}"
                          MinHeight="150"
                          MaxHeight="300"/>
                          </StackPanel>
            </Border>

            <!-- LOGS -->

            <Border Style="{StaticResource MeshCard}">
                <StackPanel>
                    <TextBlock Text="Gateway Activity Logs"
                               Style="{StaticResource MeshSectionTitle}"/>

                <DataGrid ItemsSource="{Binding Logs}"
                          MinHeight="150"
                          MaxHeight="300"/>

                    <Button Content="Reload Logs"
                            Style="{StaticResource MeshButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding LoadLogsCommand}"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
