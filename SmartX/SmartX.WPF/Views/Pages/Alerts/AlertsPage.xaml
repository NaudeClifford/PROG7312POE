<Page x:Class="SmartX.WPF.Views.Pages.Alerts.AlertsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Title="Alerts">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>

                <TextBlock Text="Alerts"
                           FontSize="28"
                           FontWeight="SemiBold"/>

                <TextBlock Text="Sensor alerts requiring attention"
                           Margin="0,5,0,0"
                           Opacity="0.7"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Padding="15,8"
                    CornerRadius="6"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="Pending:"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="{Binding PendingAlertCount}"
                               Margin="6,0,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ACTIONS -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,20,0,15">

            <Button Content="Process Next"
                    Width="120"
                    Height="34"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Style="{StaticResource BaseButtonStyle}"
                    Command="{Binding ProcessNextAlertCommand}"/>

            <Button Content="Process All"
                    Width="120"
                    Height="34"
                    Margin="0,0,10,0"
                    Cursor="Hand"
                    Style="{StaticResource BaseButtonStyle}"
                    Command="{Binding ProcessAllAlertsCommand}"/>

            <Button Content="Clear"
                    Width="90"
                    Height="34"
                    Cursor="Hand"
                    Style="{StaticResource BaseButtonStyle}"
                    Command="{Binding ClearAlertsCommand}"/>

        </StackPanel>


        <!-- ALERT LIST -->
        <Border Grid.Row="2"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- COLUMN HEADERS -->
                <Grid Grid.Row="0"
                      Margin="10,5,10,10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Severity"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="1"
                               Text="Message"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="2"
                               Text="Sensor"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Column="3"
                               Text="Time"
                               FontWeight="SemiBold"/>

                </Grid>


                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Alerts}"
                         BorderThickness="0"
                         Background="Transparent">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border Margin="5"
                                    Padding="10"
                                    BorderThickness="0,0,0,1">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- SEVERITY -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Severity}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>


                                    <!-- MESSAGE -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Message}"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>


                                    <!-- SENSOR -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding SensorName}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>


                                    <!-- TIME -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>

    </Grid>

</Page>