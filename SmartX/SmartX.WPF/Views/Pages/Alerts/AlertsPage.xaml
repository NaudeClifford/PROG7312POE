<Page x:Class="SmartX.WPF.Views.Pages.Alerts.AlertsPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:controls="clr-namespace:SmartX.WPF.Views.Controls"
mc:Ignorable="d"
Title="Alerts">

    <ScrollViewer
        x:Name="HistoryScrollViewer"
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Alerts"
                       Style="{StaticResource PageTitleStyle}"/>

                    <TextBlock
                Text="Live sensor alerts and predictive warnings"
                Style="{StaticResource SectionTitleStyle}"/>
                </StackPanel>

                <Border Grid.Column="1"
                Width="150"
                Padding="12"
                Style="{StaticResource ElevatedCardStyle}">

                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <TextBlock Text="Pending:"
                           Style="{StaticResource BodyTextStyleBlack}"/>

                        <TextBlock Text="{Binding PendingAlertCount}"
                           Style="{StaticResource BodyTextStyleBlack}"
                           Margin="6,0,0,0"/>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- ACTIONS -->
            <WrapPanel Grid.Row="1"
               Margin="0,20,0,15">

                <Button Content="Process Next"
                Margin="0,0,10,8"
                Cursor="Hand"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding ProcessNextAlertCommand}"/>

                <Button Content="Process All"
                Margin="0,0,10,8"
                Cursor="Hand"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding ProcessAllAlertsCommand}"/>

                <Button Content="Add Demo Alerts"
                Margin="0,0,10,8"
                Cursor="Hand"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding AddDemoAlertsCommand}"/>

                <Button Content="Clear"
                Margin="0,0,10,8"
                Cursor="Hand"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding ClearAlertsCommand}"/>

            </WrapPanel>

            <!-- LIVE INBOX AND PROCESSED HISTORY -->
            <Border Grid.Row="2"
            Style="{StaticResource ElevatedCardStyle}"
            Padding="12"
            Margin="0,0,0,15">

                <TabControl>

                    <!-- LIVE INBOX -->
                    <TabItem Header="Live Inbox">

                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- COLUMN HEADERS -->
                            <Grid Grid.Row="0"
                          Margin="10,8,10,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                   Text="Severity"
                                   Style="{StaticResource BodyTextStyleBlack}"/>

                                <TextBlock Grid.Column="1"
                                   Text="Message"
                                   Style="{StaticResource BodyTextStyleBlack}"/>

                                <TextBlock Grid.Column="2"
                                   Text="Time"
                                   Style="{StaticResource BodyTextStyleBlack}"/>
                            </Grid>

                            <ListBox Grid.Row="1"
                             ItemsSource="{Binding Alerts}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>

                                        <Border Margin="4"
                                        Padding="10"
                                        BorderBrush="#22000000"
                                        BorderThickness="0,0,0,1">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                   Text="{Binding Severity}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                                   Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                                <TextBlock Grid.Column="2"
                                                   Text="{Binding Timestamp,
                                                       StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                   VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- PROCESSED ALERTS -->
                    <TabItem Header="Processed">

                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                          Margin="10,8,10,8">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                   Text="Severity"
                                   Style="{StaticResource BodyTextStyleBlack}"/>

                                <TextBlock Grid.Column="1"
                                   Text="Message"
                                   Style="{StaticResource BodyTextStyleBlack}"/>

                                <TextBlock Grid.Column="2"
                                   Text="Time"
                                   Style="{StaticResource BodyTextStyleBlack}"/>
                            </Grid>

                            <ListBox Grid.Row="1"
                             ItemsSource="{Binding ProcessedAlerts}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">

                                <ListBox.ItemTemplate>
                                    <DataTemplate>

                                        <Border Margin="4"
                                        Padding="10"
                                        BorderBrush="#22000000"
                                        BorderThickness="0,0,0,1">

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="150"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                   Text="{Binding Severity}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                                   Text="{Binding Message}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                                <TextBlock Grid.Column="2"
                                                   Text="{Binding Timestamp,
                                                       StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                   VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Border>

            <!-- PREDICTIVE WARNINGS -->
            <controls:PredictiveWarningView
        Grid.Row="3"
        Margin="0,5,0,0"
        DataContext="{Binding PredictiveWarnings}"/>

        </Grid>
    </ScrollViewer>

</Page>