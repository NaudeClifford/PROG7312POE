<UserControl x:Class="SmartX.WPF.Views.Controls.PredictiveSuggestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="16"
            Margin="0,8"
            CornerRadius="8"
            BorderBrush="#D1D5DB"
            BorderThickness="1">

        <StackPanel>
            <TextBlock Text="Predictive Suggestions"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12"
                                Margin="0,0,0,8"
                                CornerRadius="6"
                                Background="#F3F4F6">

                            <StackPanel>
                                <!-- Adjust these bindings to match
                                     PredictiveSuggestion properties. -->
                                <TextBlock Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>

                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>

                                <TextBlock Text="{Binding Severity}"
                                           FontSize="12"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No predictive suggestions available."
                       Margin="0,8,0,0"
                       Opacity="0.65">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Suggestions.Count}"
                                         Value="0">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>