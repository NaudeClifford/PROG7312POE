<UserControl x:Class="SmartX.WPF.Views.Controls.PredictiveWarningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Style="{StaticResource ElevatedCardStyle}"
            Padding="18"
            ClipToBounds="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0"
                       Text="Predictive Warnings"
                       HorizontalAlignment="Center"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,0,0,16"/>

            <!-- Warning list -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ItemsControl ItemsSource="{Binding Suggestions}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <!-- One border per warning -->
                            <Border Margin="5"
                                    Padding="14"
                                    Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                <StackPanel>

                                    <TextBlock Text="{Binding SensorName}"
                                               Style="{StaticResource BodyTextStyleBlack}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Title}"
                                               Style="{StaticResource WarningTitleStyle}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource BodyTextStyleBlack}"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>

                                    <!-- Severity -->
                                    <Border Background="Black"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Center">

                                        <TextBlock Text="{Binding Severity}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="#166534"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}"
                                                                     Value="High">
                                                            <Setter Property="Foreground"
                                                                    Value="#B91C1C"/>
                                                        </DataTrigger>

                                                        <DataTrigger Binding="{Binding Severity}"
                                                                     Value="Medium">
                                                            <Setter Property="Foreground"
                                                                    Value="#C2410C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <TextBlock Text="{Binding Type}"
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,8,0,0"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding RecommendedAction}"
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="Black"
                                               Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <TextBlock Grid.Row="2"
                       Text="No predictive warnings available."
                       Margin="0,12,0,0"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource MutedTextStyle}">
                        <Setter Property="Visibility"
                                Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Suggestions.Count}"
                                         Value="0">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

        </Grid>
    </Border>
</UserControl>